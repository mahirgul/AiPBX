[Unit]
Description=AiPBX signaling capture daemon (HEPv3 -> pbx_signaling_events)
After=multi-user.target
ConditionPathExists=/opt/aipbx/signaling

[Service]
# The one Python service that parses packets from the network: it needs the
# environment file (group asterisk) and a port above 1024, nothing more.
User=asterisk
Group=asterisk
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
WorkingDirectory=/opt/aipbx/signaling
ExecStart=/usr/bin/python3 -m aipbx_signaling
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
