#!/usr/bin/python3 -I
"""Root job state and bounded snapshots of portal-owned uploads."""
import errno
import fcntl
import grp
import json
import os
from pathlib import Path
import pwd
import re
import secrets
import stat
import sys

ROOT = Path('/var/lib/aipbx-system')
LEGACY = Path('/var/lib/aipbx')
PACK = re.compile(r'(?:(core|extra)-([a-z]{2}(?:_[A-Z]{2})?)|moh-(opsound))-(wav|ulaw|alaw|gsm|g722|sln16)\Z')


class Refused(ValueError):
    pass


def clear_acl(fd):
    for name in ('system.posix_acl_access', 'system.posix_acl_default'):
        try:
            os.removexattr(fd, name)
        except OSError as error:
            if error.errno not in (errno.ENODATA, errno.ENOTSUP, errno.EINVAL):
                raise


def secure_dir(path, gid, mode):
    path.mkdir(mode=0o700, exist_ok=True)
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        info = os.fstat(fd)
        if info.st_uid != os.geteuid() or info.st_mode & 0o022:
            raise ValueError('state directory is not root-owned')
        os.fchmod(fd, 0o700)
        clear_acl(fd)
        os.fchown(fd, os.geteuid(), gid)
        os.fchmod(fd, mode)
    finally:
        os.close(fd)


def atomic(path, data, gid, mode=0o640):
    temporary = path.parent / ('.state-' + secrets.token_hex(16))
    fd = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
            os.fchown(stream.fileno(), os.geteuid(), gid)
            os.fchmod(stream.fileno(), mode)
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()


def open_portal(parts, limit, legacy=LEGACY, owners=None):
    """Pin every directory and the regular file; never resolve a portal symlink."""
    if owners is None:
        owners = {pwd.getpwnam('www-data').pw_uid}
    directory = os.open(legacy, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for part in parts[:-1]:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
            os.close(directory)
            directory = child
        fd = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
    finally:
        os.close(directory)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid not in owners or info.st_size > limit:
            raise ValueError('unsafe portal input')
        return fd
    except BaseException:
        os.close(fd)
        raise


def read_legacy(parts, limit, legacy):
    try:
        fd = open_portal(parts, limit, legacy, {os.geteuid(), pwd.getpwnam('www-data').pw_uid})
    except FileNotFoundError:
        return None
    with os.fdopen(fd, 'rb') as stream:
        data = stream.read(limit + 1)
    if len(data) > limit:
        raise ValueError('legacy state too large')
    return data


def migration(root, legacy, gid):
    imports = {}
    # Cached job states/tokens are deliberately not trusted or imported.
    network = read_legacy(('netcfg', 'state.json'), 65536, legacy)
    if network:
        state = json.loads(network)
        if not isinstance(state, dict):
            raise ValueError('invalid legacy network state')
        if state.get('state') == 'pending':
            raise Refused('finish the pending network change before upgrading')
    keep = read_legacy(('backup-keep-days',), 32, legacy)
    if keep is not None:
        if not re.fullmatch(rb'[1-9][0-9]{0,2}\s*', keep):
            raise ValueError('invalid legacy backup retention')
        imports['backup-keep-days'] = keep.strip() + b'\n'
    version = read_legacy(('installed-version',), 64, legacy)
    if version is not None and re.fullmatch(rb'[0-9]{1,5}\.[0-9]{1,5}\.[0-9]{1,5}\s*', version):
        imports['installed-version'] = version.strip() + b'\n'
    raw = read_legacy(('sound-packs.json',), 1024 * 1024, legacy)
    if raw:
        packs = json.loads(raw)
        if not isinstance(packs, dict) or len(packs) > 128:
            raise ValueError('invalid legacy sound pack catalog')
        total = 0
        for key, value in packs.items():
            match = PACK.fullmatch(key)
            if not match or not isinstance(value, dict):
                raise ValueError('invalid legacy sound pack')
            manifest = read_legacy(('sound-packs', key + '.list'), 2 * 1024 * 1024, legacy)
            if manifest is not None:
                total += len(manifest)
                if total > 32 * 1024 * 1024:
                    raise ValueError('legacy manifests too large')
                for line in manifest.decode('utf-8').splitlines():
                    if (not re.fullmatch(r'[A-Za-z0-9_./-]{1,512}', line)
                            or line.startswith('/') or '..' in line.split('/')):
                        raise ValueError('unsafe legacy sound manifest')
                imports['sound-packs/' + key + '.list'] = manifest
            # These values are display metadata, never root command arguments.
            if any(not isinstance(v, (str, int, bool)) or isinstance(v, str) and len(v) > 1024 for v in value.values()):
                raise ValueError('invalid legacy sound metadata')
            kind, lang, moh, fmt = match.groups()
            value.update(kind=kind or 'moh', lang=lang or moh, format=fmt)
            value['path'] = '/var/lib/asterisk/moh/opsound' if moh else '/var/lib/asterisk/sounds/' + lang
        imports['sound-packs.json'] = json.dumps(packs, ensure_ascii=False).encode()
    for name, data in imports.items():
        atomic(root / name, data, gid)


def prepare(root=ROOT, legacy=LEGACY, gid=None, lock_path=Path('/run/aipbx-system-state.lock')):
    if gid is None:
        gid = grp.getgrnam('www-data').gr_gid
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    with os.fdopen(fd, 'rb') as lock:
        info = os.fstat(lock.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1:
            raise ValueError('unsafe system state lock')
        os.fchmod(lock.fileno(), 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        secure_dir(root, gid, 0o750)
        secure_dir(root / 'private', os.getegid(), 0o700)
        secure_dir(root / 'netcfg', os.getegid(), 0o700)
        secure_dir(root / 'sound-packs', gid, 0o750)
        marker = root / '.initialized'
        if not marker.exists():
            migration(root, legacy, gid)
            atomic(marker, b'1\n', os.getegid(), 0o600)


def snapshot(kind, destination, filename=None):
    specs = {'cert': (('cert-stage', 'cert.pem'), 65536),
             'key': (('cert-stage', 'key.pem'), 16384),
             'cloudflare': (('cert-stage', 'cloudflare.ini'), 1024)}
    if kind == 'backup':
        if filename is None or not re.fullmatch(r'[0-9a-f]{32}\.part', filename):
            raise ValueError('invalid upload name')
        parts, limit = ('backup-upload', filename), 5 * 1024 ** 3
    else:
        parts, limit = specs[kind]
    fd = open_portal(parts, limit)
    with os.fdopen(fd, 'rb') as source:
        parent = os.open(destination.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            info = os.fstat(parent)
            if info.st_uid != os.geteuid() or info.st_mode & 0o022:
                raise ValueError('snapshot destination is not private')
            target = os.open(destination.name, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600, dir_fd=parent)
            with os.fdopen(target, 'wb') as out:
                remaining = limit + 1
                while remaining:
                    data = source.read(min(1024 * 1024, remaining))
                    if not data:
                        return
                    out.write(data)
                    remaining -= len(data)
                raise ValueError('upload exceeds size limit')
        finally:
            os.close(parent)


def main():
    if os.geteuid() != 0:
        raise ValueError('root required')
    args = sys.argv[1:]
    if args == ['prepare']:
        prepare()
    elif len(args) == 2 and args[0] == 'keep' and re.fullmatch(r'[1-9][0-9]{0,2}', args[1]):
        prepare()
        atomic(ROOT / 'backup-keep-days', (args[1] + '\n').encode(), grp.getgrnam('www-data').gr_gid)
    elif len(args) in (3, 4) and args[0] == 'snapshot':
        snapshot(args[1], Path(args[2]), args[3] if len(args) == 4 else None)
    else:
        raise ValueError('invalid system state operation')


if __name__ == '__main__':
    try:
        main()
    except Refused as error:
        print('aipbx-system-state: ' + str(error), file=sys.stderr)
        sys.exit(1)
    except (OSError, ValueError, KeyError) as error:
        # No uploaded contents, credentials or JSON values in errors.
        print('aipbx-system-state: operation refused (' + type(error).__name__ + ')', file=sys.stderr)
        sys.exit(1)
