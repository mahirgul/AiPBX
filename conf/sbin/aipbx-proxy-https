#!/usr/bin/python3 -I
"""Install the HTTP redirect condition from validated proxy settings, never raw config."""
import fcntl
import ipaddress
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile

DIRECTORY = Path('/etc/apache2/aipbx')
MAX_INPUT = 16384


def render(settings):
    if (not isinstance(settings, dict) or set(settings) != {'enabled', 'trusted_proxies'}
            or type(settings['enabled']) is not bool
            or not isinstance(settings['trusted_proxies'], str)
            or len(settings['trusted_proxies']) > 8192):
        raise ValueError('invalid proxy settings')
    tokens = re.split(r'[\s,]+', settings['trusted_proxies'].strip())
    tokens = [token for token in tokens if token]
    if len(tokens) > 128:
        raise ValueError('too many trusted proxies')
    networks = []
    for token in tokens:
        # Reject scoped IPv6 and non-numeric prefixes, including netmask notation.
        if '%' in token or ('/' in token and not token.split('/', 1)[1].isascii()):
            raise ValueError('invalid trusted proxy')
        if '/' in token and not re.fullmatch(r'[0-9]{1,3}', token.split('/', 1)[1]):
            raise ValueError('invalid trusted proxy prefix')
        network = str(ipaddress.ip_network(token, strict=False))
        if network not in networks:
            networks.append(network)
    condition = 'true'
    if settings['enabled'] and networks:
        peers = ' || '.join("%{CONN_REMOTE_ADDR} -ipmatch '" + net + "'" for net in networks)
        condition = "! ( (" + peers + ") && req('X-Forwarded-Proto') =~ /^https$/i )"
    return '# Managed by aipbx-proxy-https; do not edit.\nRewriteCond expr "' + condition + '"\n'


def atomic_write(path, content):
    fd, name = tempfile.mkstemp(prefix='.proxy-https-', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
            os.fchmod(stream.fileno(), 0o644)
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def configure(settings, reload=True, directory=DIRECTORY):
    content = render(settings).encode('ascii')
    directory.mkdir(mode=0o755, exist_ok=True)
    info = directory.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o022:
        raise ValueError('unsafe Apache proxy directory')
    fd = os.open(directory / '.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'rb') as lock:
        info = os.fstat(lock.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_nlink != 1:
            raise ValueError('unsafe Apache proxy lock')
        os.fchmod(lock.fileno(), 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        path = directory / 'proxy-https.conf'
        old = None
        if path.exists() or path.is_symlink():
            info = path.lstat()
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                    or info.st_mode & 0o022 or info.st_size > 65536):
                raise ValueError('unsafe Apache proxy configuration')
            old = path.read_bytes()
        # Still validate/reload on apply when the bytes match: a previous failed
        # reload must not make a retry report success with stale active rules.
        atomic_write(path, content)
        if not reload:
            return
        attempted_reload = False
        try:
            subprocess.run(['/usr/sbin/apache2ctl', 'configtest'], check=True, capture_output=True, timeout=30)
            attempted_reload = True
            subprocess.run(['/usr/bin/systemctl', 'reload', 'apache2'], check=True, capture_output=True, timeout=30)
        except (subprocess.SubprocessError, OSError):
            if old is None:
                path.unlink()
            else:
                atomic_write(path, old)
            if attempted_reload:
                # A reload may have partially succeeded: restore the active rules too.
                subprocess.run(['/usr/bin/systemctl', 'reload', 'apache2'], check=True, capture_output=True, timeout=30)
            raise RuntimeError('Apache refused proxy settings; previous configuration restored') from None


def main():
    if os.geteuid() != 0 or len(sys.argv) != 2 or sys.argv[1] not in ('install', 'apply'):
        raise ValueError('usage (root only): aipbx-proxy-https install|apply < settings.json')
    data = sys.stdin.buffer.read(MAX_INPUT + 1)
    if len(data) > MAX_INPUT:
        raise ValueError('proxy settings too large')
    configure(json.loads(data), reload=sys.argv[1] == 'apply')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, RuntimeError, subprocess.SubprocessError) as error:
        print('aipbx-proxy-https: ' + str(error), file=sys.stderr)
        sys.exit(1)
