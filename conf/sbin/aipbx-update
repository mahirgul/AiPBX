#!/bin/bash
# aipbx-update — updates AiPBX to a published release (git tag vX.Y.Z).
#
#   aipbx-update --check              is a newer release available? (writes a status file for the portal)
#   aipbx-update                      update to the latest release (asks for confirmation)
#   aipbx-update --to v2.1.0          update to a specific release
#   aipbx-update --yes                no confirmation (portal / automation)
#   aipbx-update --allow-calls        when a restart is needed: end the calls in progress
#   aipbx-update --wait-calls         when a restart is needed: wait until the calls have ended
#
# Without either, a person at the terminal is asked; --yes alone stops instead.
#
# Asterisk is restarted only when the update needs it
# (scripts/asterisk-restart-needed.sh of the target release decides); otherwise it
# is reloaded and the update runs even while calls are in progress.
#
# Flow: checks → backup (database, /etc/ai-pbx.env, /etc/asterisk) → check out
# the tag → `install.sh --upgrade` (migrations, permissions, service settings;
# secrets are never regenerated) → verification. If any step fails, code,
# database and system settings are restored to the previous release automatically.
#
# install.sh COPIES this file to /usr/local/sbin as root:root 0755.

set -uo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C.UTF-8

# During the update install.sh replaces the copy in /usr/local/sbin; overwriting
# a running bash script corrupts it, so we run from a temporary copy.
if [[ -z "${AIPBX_UPDATE_REEXEC:-}" && -z "${AIPBX_UPDATE_COPIED:-}" ]]; then
    tmp="$(mktemp /run/aipbx-update.XXXXXX 2>/dev/null || mktemp /tmp/aipbx-update.XXXXXX)"
    cp "$0" "$tmp" && chmod 700 "$tmp"
    AIPBX_UPDATE_COPIED=1 AIPBX_UPDATE_REEXEC="$tmp" exec /bin/bash "$tmp" "$@"
fi
trap 'rm -f "${AIPBX_UPDATE_REEXEC:-}"' EXIT

INSTALL_DIR="${AIPBX_INSTALL_DIR:-/opt/aipbx}"
STATE_DIR=/var/lib/aipbx-system
STATUS_FILE="$STATE_DIR/update-status.json"   # read by the portal (www-data)
CHECK_FILE="$STATE_DIR/update-check.json"     # read by the portal (www-data)
LOG_FILE=/var/log/aipbx/update.log
BACKUP_ROOT=/var/backups/aipbx
KEEP_BACKUPS=5

MODE=update; TARGET=""; ASSUME_YES=false; ALLOW_CALLS=false; WAIT_CALLS=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --check) MODE=check ;;
        --to) TARGET="${2:-}"; shift ;;
        --yes|-y) ASSUME_YES=true ;;
        --allow-calls) ALLOW_CALLS=true ;;
        --wait-calls) WAIT_CALLS=true ;;
        -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "Unknown argument: $1 (--help)" >&2; exit 64 ;;
    esac
    shift
done

[[ $EUID -eq 0 ]] || { echo "Run as root: sudo aipbx-update" >&2; exit 1; }
[[ -d "$INSTALL_DIR/.git" ]] || { echo "$INSTALL_DIR is not an AiPBX git installation" >&2; exit 1; }

/usr/local/sbin/aipbx-log-init update || exit 1
/usr/local/sbin/aipbx-system-state prepare || exit 1
mkdir -p "$STATE_DIR" "$BACKUP_ROOT"
chmod 700 "$BACKUP_ROOT"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" | tee -a "$LOG_FILE"; }
json_str() { printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'; }

write_check_file() {
    local tmpc; tmpc="$(mktemp "$STATE_DIR/.update-check.XXXXXX")"
    cat > "$tmpc"
    chmod 644 "$tmpc"
    [[ -L "$CHECK_FILE" ]] && rm -f "$CHECK_FILE"
    mv -f "$tmpc" "$CHECK_FILE"
}

# state: running | done | failed | rolled_back
status() {
    local state="$1" step="$2"
    local tmpf; tmpf="$(mktemp "$STATE_DIR/.update-status.XXXXXX")"
    printf '{"state":%s,"step":%s,"from":%s,"to":%s,"waiting_calls":%d,"updated_at":%s}\n' \
        "$(json_str "$state")" "$(json_str "$step")" "$(json_str "${FROM_VERSION:-${CURRENT:-}}")" \
        "$(json_str "${TARGET:-}")" "${WAITING_CALLS:-0}" "$(json_str "$(date -Iseconds)")" > "$tmpf"
    chmod 644 "$tmpf"
    [[ -L "$STATUS_FILE" ]] && rm -f "$STATUS_FILE"
    mv -f "$tmpf" "$STATUS_FILE"
}

git_in() { git -c safe.directory="$INSTALL_DIR" -C "$INSTALL_DIR" "$@"; }
ver_of() { echo "${1#v}"; }
# a < b ?  (version comparison)
ver_lt() { [[ "$(ver_of "$1")" != "$(ver_of "$2")" && "$(printf '%s\n%s\n' "$(ver_of "$1")" "$(ver_of "$2")" | sort -V | head -1)" == "$(ver_of "$1")" ]]; }

CURRENT="v$(tr -d '[:space:]' < "$INSTALL_DIR/VERSION" 2>/dev/null || echo 0.0.0)"
CURRENT_COMMIT="$(git_in rev-parse HEAD)"

# ---------------------------------------------------------------- fetch releases
# --prune-tags: a release tag deleted on GitHub (e.g. when versioning was reset
# to 1.0.0) must disappear here too; a stale local v2.2.2 was offered as an
# "update" and would have moved the installation back to old code.
if ! git_in fetch --quiet --tags --force --prune --prune-tags origin 2>>"$LOG_FILE"; then
    log "ERROR: could not reach GitHub (git fetch)"
    [[ "$MODE" == check ]] && printf '{"ok":false,"error":"GitHub unreachable","current":%s,"checked_at":%s}\n' \
        "$(json_str "$CURRENT")" "$(json_str "$(date -Iseconds)")" | write_check_file
    exit 2
fi
LATEST="$(git_in tag -l 'v[0-9]*.[0-9]*.[0-9]*' --sort=-v:refname | head -1)"

# "no" or "yes: <reason>" for an update from the installed code to release $1.
# The target release's own rules decide; a release without them restarts.
restart_needed() {
    local script
    script="$(git_in show "$1:scripts/asterisk-restart-needed.sh" 2>/dev/null)"
    if [[ -z "$script" ]]; then echo "yes: $1 does not say"; return; fi
    bash -c "$script" _ "$INSTALL_DIR" "$CURRENT_COMMIT" "$1" 2>/dev/null || echo "yes: check failed"
}

if [[ "$MODE" == check ]]; then
    available=false; notes=""
    if [[ -n "$LATEST" ]] && ver_lt "$CURRENT" "$LATEST"; then
        available=true
        # Notes of every release newer than the installed one (tag messages).
        while read -r t; do
            ver_lt "$CURRENT" "$t" || continue
            notes+="## ${t}"$'\n'"$(git_in tag -l --format='%(contents)' "$t")"$'\n\n'
        done < <(git_in tag -l 'v[0-9]*.[0-9]*.[0-9]*' --sort=-v:refname)
    fi
    restart=true; restart_reason=""
    if [[ "$available" == true ]]; then
        r="$(restart_needed "$LATEST")"
        [[ "$r" == no ]] && restart=false || restart_reason="${r#yes: }"
    fi
    printf '{"ok":true,"current":%s,"latest":%s,"available":%s,"restart":%s,"restart_reason":%s,"notes":%s,"checked_at":%s}\n' \
        "$(json_str "$CURRENT")" "$(json_str "${LATEST:-}")" "$available" "$restart" "$(json_str "$restart_reason")" \
        "$(json_str "$notes")" "$(json_str "$(date -Iseconds)")" | write_check_file
    echo "Installed: $CURRENT   Latest: ${LATEST:-none}   $([[ $available == true ]] && echo 'UPDATE AVAILABLE' || echo 'up to date')"
    exit 0
fi

# ------------------------------------------------------------------ target release
[[ -n "$TARGET" ]] || TARGET="$LATEST"
[[ "$TARGET" == v* ]] || TARGET="v$TARGET"
if [[ -z "$TARGET" || -z "$(git_in tag -l "$TARGET")" ]]; then
    echo "Release not found: ${TARGET:-(no tags)}" >&2; exit 1
fi
if ! ver_lt "$CURRENT" "$TARGET"; then
    echo "Installed version ($CURRENT) is already $TARGET or newer."; exit 0
fi

# Bridge release: a release with an UPGRADE_FROM file applies only to that
# version or newer (install.sh --upgrade refuses older ones). An older
# installation goes to the bridge release first, then on to the target.
FINAL_TARGET=""
need_from="$(git_in show "$TARGET:UPGRADE_FROM" 2>/dev/null | tr -d '[:space:]')"
if [[ -n "$need_from" ]] && ver_lt "$CURRENT" "v$need_from"; then
    if [[ -z "$(git_in tag -l "v$need_from")" ]]; then
        echo "$TARGET needs AiPBX $need_from first, but release v$need_from was not found." >&2; exit 1
    fi
    log "$TARGET needs $need_from or newer: updating to the bridge release v$need_from first"
    FINAL_TARGET="$TARGET"
    TARGET="v$need_from"
fi

# ------------------------------------------------------------------ pre-checks
# Hand-edited code would be overwritten by the update.
# File mode changes do not count: an installer that chmods a script (1.34.0-1.34.2
# did that with web/bin/aipbx_ops.php) must not block every later update; the
# checkout below restores the modes anyway.
# They do not stop the update: they go into the backup, and come back after it unless the
# new release changes the same file (then the release's version is used).
HAND_FILES=()
while IFS= read -r -d '' f; do
    HAND_FILES+=("$f")
done < <(git_in -c core.fileMode=false diff --name-only -z --diff-filter=M HEAD 2>/dev/null)
HAND_KEPT=0; HAND_REPLACED=0

RESTART_REASON="$(restart_needed "$TARGET")"
if [[ "$RESTART_REASON" == no ]]; then
    export AIPBX_ASTERISK_RESTART=no
else
    export AIPBX_ASTERISK_RESTART=yes
fi
# Bounded: a stuck Asterisk must not hold the update up until someone restarts it by hand.
active_calls() {
    timeout 15 asterisk -rx 'core show channels count' 2>/dev/null | sed -n 's/^\([0-9]\+\) active call.*/\1/p'
}
END_CALLS_FLAG=/run/aipbx-update-end-calls
CANCEL_FLAG=/run/aipbx-update-cancel
WAIT_MAX_SECONDS=$((4 * 3600))
rm -f "$END_CALLS_FLAG" "$CANCEL_FLAG"

wait_for_calls() {
    local started seen="" n
    started="$(date +%s)"
    while :; do
        n="$(active_calls)"; n="${n:-0}"
        [[ "$n" -gt 0 ]] || { WAITING_CALLS=0; log "No calls in progress, continuing"; return 0; }
        if [[ -e "$CANCEL_FLAG" ]]; then
            rm -f "$CANCEL_FLAG"; WAITING_CALLS=0
            log "Cancelled while waiting for ${n} call(s)"
            status failed "Cancelled while waiting for calls"
            exit 3
        fi
        if [[ -e "$END_CALLS_FLAG" ]]; then
            rm -f "$END_CALLS_FLAG"; WAITING_CALLS=0; ALLOW_CALLS=true
            log "Asked to end the ${n} call(s) in progress instead of waiting"
            return 0
        fi
        if (( $(date +%s) - started > WAIT_MAX_SECONDS )); then
            WAITING_CALLS=0
            log "Still ${n} call(s) after $((WAIT_MAX_SECONDS / 3600)) hours, stopping"
            status failed "Calls still in progress after $((WAIT_MAX_SECONDS / 3600)) hours"
            exit 3
        fi
        if [[ "$n" != "$seen" ]]; then
            seen="$n"
            log "Waiting for ${n} call(s) to end"
            [[ -t 0 ]] && echo "Press e to end the calls now, c to cancel."
        fi
        # Written each round: the portal tells a wait from an update that died by its age.
        WAITING_CALLS="$n"
        status running "Waiting for ${n} call(s) to end"
        if [[ -t 0 ]]; then
            key=""
            read -r -s -n 1 -t 5 key || true
            case "${key,,}" in
                e) touch "$END_CALLS_FLAG" ;;
                c) touch "$CANCEL_FLAG" ;;
            esac
        else
            sleep 5
        fi
    done
}

calls="$(active_calls)"
if [[ "$AIPBX_ASTERISK_RESTART" == yes && "${calls:-0}" -gt 0 && "$ALLOW_CALLS" != true ]]; then
    if [[ "$WAIT_CALLS" != true && "$ASSUME_YES" != true && -t 0 ]]; then
        echo "${calls} call(s) in progress, and this update restarts Asterisk."
        read -r -p "[w]ait until they end, [e]nd them now, or [c]ancel? [w/e/c]: " ans
        case "${ans,,}" in
            w|wait) WAIT_CALLS=true ;;
            e|end) ALLOW_CALLS=true ;;
            *) echo "Cancelled."; exit 0 ;;
        esac
    fi
    if [[ "$WAIT_CALLS" == true && "$ALLOW_CALLS" != true ]]; then
        wait_for_calls
    elif [[ "$ALLOW_CALLS" != true ]]; then
        echo "${calls} call(s) in progress; the update restarts Asterisk and they would drop." >&2
        echo "Choose: --wait-calls waits until they end, --allow-calls ends them." >&2
        status failed "Calls in progress (${calls})"
        exit 3
    fi
fi

if [[ "$ASSUME_YES" != true ]]; then
    read -r -p "Update AiPBX $CURRENT → $TARGET? [y/N]: " ans
    [[ "${ans,,}" == y || "${ans,,}" == yes ]] || { echo "Cancelled."; exit 0; }
fi

log "===== Update started: $CURRENT → $TARGET ====="
if [[ "$AIPBX_ASTERISK_RESTART" == no ]]; then
    log "Asterisk needs no restart this time, only a reload"
else
    log "Asterisk: restart (${RESTART_REASON#yes: })"
fi
status running "Taking a backup"

# ------------------------------------------------------------------ backup
# First a full backup with the daily backup tool: it is listed on the Backup page
# (aipbx-YYYYmmdd-HHMM-before-update) and can be restored from there like any
# other. The copy below is only for this script's own automatic rollback.
if [[ -x /usr/local/sbin/aipbx-backup ]]; then
    if ! FULL_BACKUP_LOG="$(/usr/local/sbin/aipbx-backup --label before-update 2>&1)"; then
        log "ERROR: the full backup failed, nothing was changed: $FULL_BACKUP_LOG"
        status failed "Full backup failed"
        exit 1
    fi
    log "Full backup: $(printf '%s\n' "$FULL_BACKUP_LOG" | grep -o '/[^ ]*before-update' | tail -n 1)"
fi
DB_NAME="$(grep -m1 '^DB_NAME=' /etc/ai-pbx.env 2>/dev/null | cut -d= -f2- | tr -d "\"'" || true)"
[[ "$DB_NAME" =~ ^[A-Za-z0-9_]+$ ]] || DB_NAME=asterisk
BACKUP_DIR="$BACKUP_ROOT/$(date +%Y%m%d-%H%M%S)_${CURRENT}"
mkdir -p "$BACKUP_DIR"
echo "$CURRENT_COMMIT" > "$BACKUP_DIR/commit"
echo "$CURRENT" > "$BACKUP_DIR/version"
cp -p /etc/ai-pbx.env "$BACKUP_DIR/ai-pbx.env"
tar czf "$BACKUP_DIR/etc-asterisk.tgz" -C / etc/asterisk 2>>"$LOG_FILE"
if [[ -d /var/lib/aipbx/plugins ]]; then
    tar czf "$BACKUP_DIR/custom-plugins.tgz" -C / var/lib/aipbx/plugins 2>>"$LOG_FILE" || true
fi
mysqldump --single-transaction --routines --triggers --databases "$DB_NAME" 2>>"$LOG_FILE" | gzip > "$BACKUP_DIR/asterisk-db.sql.gz"
if ! zcat "$BACKUP_DIR/asterisk-db.sql.gz" 2>/dev/null | tail -n 1 | grep -q 'Dump completed'; then
    log "ERROR: database backup failed, nothing was changed"
    status failed "Database backup failed"
    exit 1
fi
if [[ ${#HAND_FILES[@]} -gt 0 ]]; then
    printf '%s\0' "${HAND_FILES[@]}" | tar czf "$BACKUP_DIR/hand-changed-files.tgz" -C "$INSTALL_DIR" --null -T - 2>>"$LOG_FILE" \
        || { log "ERROR: could not save the files changed by hand, nothing was changed"; status failed "Backup of changed files failed"; exit 1; }
    log "Files changed by hand (${#HAND_FILES[@]}) saved in $BACKUP_DIR/hand-changed-files.tgz"
fi
log "Backup: $BACKUP_DIR"
# Prune old backups (the last $KEEP_BACKUPS are kept). Only this script's own
# folders (<date>-<time>_<version>): BACKUP_ROOT may be shared with aipbx-backup.
ls -1dt "$BACKUP_ROOT"/[0-9]*_*/ 2>/dev/null | tail -n +$((KEEP_BACKUPS + 1)) | xargs -r rm -rf

# ------------------------------------------------------------------ rollback
rollback() {
    log "!!! $1 — returning to the previous release ($CURRENT)"
    status running "Rolling back: $1"
    git_in checkout --quiet --force "$CURRENT_COMMIT" >>"$LOG_FILE" 2>&1
    [[ -s "$BACKUP_DIR/hand-changed-files.tgz" ]] && tar xzf "$BACKUP_DIR/hand-changed-files.tgz" -C "$INSTALL_DIR" 2>>"$LOG_FILE"
    # Restore the database exactly as backed up: tables added by the new
    # migrations are not in the dump, so the database is dropped first — but
    # ONLY when the dump is complete.
    if zcat "$BACKUP_DIR/asterisk-db.sql.gz" | tail -n 1 | grep -q 'Dump completed'; then
        if mysql -e "DROP DATABASE IF EXISTS \`${DB_NAME}\`" 2>>"$LOG_FILE" \
           && zcat "$BACKUP_DIR/asterisk-db.sql.gz" | mysql 2>>"$LOG_FILE"; then
            log "Database restored from backup"
        else
            # The dropped database is gone, so one more try. Then stop: carrying on
            # would start the services on half a database, and the admin must see it.
            log "WARNING: database restore failed, trying once more"
            sleep 5
            if mysql -e "DROP DATABASE IF EXISTS \`${DB_NAME}\`" 2>>"$LOG_FILE" \
               && zcat "$BACKUP_DIR/asterisk-db.sql.gz" | mysql 2>>"$LOG_FILE"; then
                log "Database restored from backup on the second try"
            else
                log "ERROR: database restore failed. Restore it by hand: zcat $BACKUP_DIR/asterisk-db.sql.gz | mysql, then run: bash $INSTALL_DIR/install.sh --upgrade"
                status failed "Database restore failed: zcat $BACKUP_DIR/asterisk-db.sql.gz | mysql, then run: bash $INSTALL_DIR/install.sh --upgrade"
                exit 4
            fi
        fi
    else
        log "WARNING: backup looks incomplete, database left untouched: $BACKUP_DIR"
    fi
    cp -p "$BACKUP_DIR/ai-pbx.env" /etc/ai-pbx.env
    # install.sh below rewrites most of /etc/asterisk again; the backup also
    # brings back files it does not write (keys, hand-edited files).
    if [[ -s "$BACKUP_DIR/etc-asterisk.tgz" ]]; then
        tar xzf "$BACKUP_DIR/etc-asterisk.tgz" -C / 2>>"$LOG_FILE" \
            && log "Asterisk configuration restored from backup" \
            || log "WARNING: /etc/asterisk restore failed — by hand: tar xzf $BACKUP_DIR/etc-asterisk.tgz -C /"
    fi
    if [[ -s "$BACKUP_DIR/custom-plugins.tgz" ]]; then
        tar xzf "$BACKUP_DIR/custom-plugins.tgz" -C / 2>>"$LOG_FILE" || true
    fi
    bash "$INSTALL_DIR/install.sh" --upgrade >>"$LOG_FILE" 2>&1 \
        || log "WARNING: could not re-apply the previous release's system settings"
    log "===== Rolled back to $CURRENT ($1) ====="
    status rolled_back "$1"
    /bin/bash "${AIPBX_UPDATE_REEXEC:-$0}" --check >/dev/null 2>&1 || true
    exit 1
}

# ------------------------------------------------------------------ apply
status running "Checking out $TARGET"
git_in checkout --quiet --force --detach "$TARGET" >>"$LOG_FILE" 2>&1 || rollback "Checkout failed"
if [[ ${#HAND_FILES[@]} -gt 0 ]]; then
    for f in "${HAND_FILES[@]}"; do
        if git_in diff --quiet "$CURRENT_COMMIT" "$TARGET" -- "$f" 2>/dev/null; then
            tar xzf "$BACKUP_DIR/hand-changed-files.tgz" -C "$INSTALL_DIR" -- "$f" 2>>"$LOG_FILE" \
                && HAND_KEPT=$((HAND_KEPT + 1))
        else
            HAND_REPLACED=$((HAND_REPLACED + 1))
            log "NOTE: this release changes $f, so your version was not kept (it is in the backup)"
        fi
    done
    log "Files changed by hand: $HAND_KEPT kept, $HAND_REPLACED replaced by the release"
fi

# Clean hang-ups before the restart: phones and trunks hear a BYE and the calls get their CDRs.
if [[ "$AIPBX_ASTERISK_RESTART" == yes && "$ALLOW_CALLS" == true && "$(active_calls)" -gt 0 ]] 2>/dev/null; then
    log "Ending the calls in progress"
    timeout 15 asterisk -rx 'channel request hangup all' >>"$LOG_FILE" 2>&1 || true
    sleep 2
fi

status running "Updating the system (packages, database, services)"
log "Running install.sh --upgrade..."
bash "$INSTALL_DIR/install.sh" --upgrade >>"$LOG_FILE" 2>&1 || rollback "install.sh --upgrade failed"

# --- signaling capture components: kept explicit here so the update path
# cannot skip them for any reason.
if [ -d "$INSTALL_DIR/signaling" ]; then
    if command -v apt-get >/dev/null 2>&1 && ! dpkg -s python3-pymysql >/dev/null 2>&1; then
        DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3-pymysql >>"$LOG_FILE" 2>&1 \
            || rollback "python3-pymysql install failed"
    fi
    if [ -d /etc/systemd/system ] && [ -f "$INSTALL_DIR/conf/systemd/aipbx-signaling.service" ]; then
        if ! cmp -s "$INSTALL_DIR/conf/systemd/aipbx-signaling.service" /etc/systemd/system/aipbx-signaling.service 2>/dev/null; then
            install -o root -g root -m 0644 "$INSTALL_DIR/conf/systemd/aipbx-signaling.service" /etc/systemd/system/aipbx-signaling.service
            systemctl daemon-reload >>"$LOG_FILE" 2>&1
        fi
        systemctl enable aipbx-signaling.service >>"$LOG_FILE" 2>&1 || true
        systemctl restart aipbx-signaling.service >>"$LOG_FILE" 2>&1 || true
    fi
fi

# ------------------------------------------------------------------ verification
status running "Verifying"
# Twice: a service that crashes on start looks active between two of its restarts.
for wait_s in 3 8; do
    sleep "$wait_s"
    for svc in mariadb apache2 nginx asterisk aipbx-webhook-worker; do
        systemctl is-active --quiet "$svc" || rollback "$svc is not running"
    done
done
domain="$(grep -m1 '^PORTAL_DOMAIN=' /etc/ai-pbx.env 2>/dev/null | cut -d= -f2- | tr -d "\"'" || true)"
domain="${domain#[\"\']}"; domain="${domain%[\"\']}"
[[ -z "$domain" ]] && domain=127.0.0.1
code="$(curl -sk -o /dev/null -w '%{http_code}' --max-time 15 --resolve "${domain}:443:127.0.0.1" "https://${domain}/login" || echo 000)"
[[ "$code" == 200 ]] || rollback "Portal not responding (HTTP $code)"
# The services and the portal are up, so the update is done. The test of every page takes minutes on a
# small server and decides nothing here, so it runs afterwards and only reports: the System Update page
# shows the result file if it found a problem.
SMOKE_RESULT="$STATE_DIR/update-page-test-failed"
rm -f "$SMOKE_RESULT"
SMOKE_NOTE=""
systemd-run --quiet --collect --unit="aipbx-update-page-test-$$" --description='AiPBX: test every page after an update' /bin/bash -c \
    "cd '$INSTALL_DIR/web' && timeout 900 sudo -n -u www-data php bin/smoke.php >>'$LOG_FILE' 2>&1 || { date '+%F %T' > '$SMOKE_RESULT'; chmod 644 '$SMOKE_RESULT'; echo 'WARNING: the page tests (smoke) found problems; see above. The update stays.' >>'$LOG_FILE'; }" \
    2>>"$LOG_FILE" || log "The page test could not be started; run bin/smoke.php by hand if you want it."

log "===== Update completed: $CURRENT → $TARGET ====="
FROM_VERSION="$CURRENT"
HAND_NOTE=""
[[ ${#HAND_FILES[@]} -gt 0 ]] && HAND_NOTE=", files changed by hand: $HAND_KEPT kept, $HAND_REPLACED replaced"
status "done" "Updated: $CURRENT → $TARGET$HAND_NOTE$SMOKE_NOTE"
# Refresh the portal's "update available" information.
/bin/bash "${AIPBX_UPDATE_REEXEC:-$0}" --check >/dev/null 2>&1 || true
echo "AiPBX updated to $TARGET. Backup: $BACKUP_DIR"

# Continue from the bridge release to the requested one with the bridge's own
# (just installed) updater.
if [[ -n "$FINAL_TARGET" ]]; then
    log "Bridge release $TARGET installed, continuing to $FINAL_TARGET"
    next=(--to "$FINAL_TARGET" --yes)
    [[ "$ALLOW_CALLS" == true ]] && next+=(--allow-calls)
    [[ "$WAIT_CALLS" == true && "$ALLOW_CALLS" != true ]] && next+=(--wait-calls)
    rm -f "${AIPBX_UPDATE_REEXEC:-}"
    exec env -u AIPBX_UPDATE_REEXEC -u AIPBX_UPDATE_COPIED /usr/local/sbin/aipbx-update "${next[@]}"
fi
