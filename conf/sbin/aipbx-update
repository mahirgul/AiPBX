#!/bin/bash
# aipbx-update — updates AiPBX to a published release (git tag vX.Y.Z).
#
#   aipbx-update --check              is a newer release available? (writes a status file for the portal)
#   aipbx-update                      update to the latest release (asks for confirmation)
#   aipbx-update --to v2.1.0          update to a specific release
#   aipbx-update --yes                no confirmation (portal / automation)
#   aipbx-update --allow-calls        continue even with active calls (they will drop)
#
# Flow: checks → backup (database, /etc/ai-pbx.env, /etc/asterisk) → check out
# the tag → `install.sh --upgrade` (migrations, permissions, service settings;
# secrets are never regenerated) → verification. If any step fails, code,
# database and system settings are restored to the previous release automatically.
#
# install.sh COPIES this file to /usr/local/sbin as root:root 0755.

set -uo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C.UTF-8

# During the update install.sh replaces the copy in /usr/local/sbin; overwriting
# a running bash script corrupts it, so we run from a temporary copy.
if [[ -z "${AIPBX_UPDATE_REEXEC:-}" ]]; then
    tmp="$(mktemp /tmp/aipbx-update.XXXXXX)"
    cp "$0" "$tmp" && chmod 700 "$tmp"
    AIPBX_UPDATE_REEXEC="$tmp" exec bash "$tmp" "$@"
fi
trap 'rm -f "$AIPBX_UPDATE_REEXEC"' EXIT

INSTALL_DIR="${AIPBX_INSTALL_DIR:-/opt/aipbx}"
STATE_DIR=/var/lib/aipbx
STATUS_FILE="$STATE_DIR/update-status.json"   # read by the portal (www-data)
CHECK_FILE="$STATE_DIR/update-check.json"     # read by the portal (www-data)
LOG_FILE=/var/log/aipbx/update.log
BACKUP_ROOT=/var/backups/aipbx
KEEP_BACKUPS=5

MODE=update; TARGET=""; ASSUME_YES=false; ALLOW_CALLS=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --check) MODE=check ;;
        --to) TARGET="${2:-}"; shift ;;
        --yes|-y) ASSUME_YES=true ;;
        --allow-calls) ALLOW_CALLS=true ;;
        -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "Unknown argument: $1 (--help)" >&2; exit 64 ;;
    esac
    shift
done

[[ $EUID -eq 0 ]] || { echo "Run as root: sudo aipbx-update" >&2; exit 1; }
[[ -d "$INSTALL_DIR/.git" ]] || { echo "$INSTALL_DIR is not an AiPBX git installation" >&2; exit 1; }

mkdir -p "$STATE_DIR" "$(dirname "$LOG_FILE")" "$BACKUP_ROOT"
chmod 700 "$BACKUP_ROOT"
touch "$LOG_FILE"; chgrp www-data "$LOG_FILE" 2>/dev/null; chmod 640 "$LOG_FILE"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" | tee -a "$LOG_FILE"; }
json_str() { printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'; }

# state: running | done | failed | rolled_back
status() {
    local state="$1" step="$2"
    local tmpf; tmpf="$(mktemp "$STATE_DIR/.update-status.XXXXXX")"
    printf '{"state":%s,"step":%s,"from":%s,"to":%s,"updated_at":%s}\n' \
        "$(json_str "$state")" "$(json_str "$step")" "$(json_str "${FROM_VERSION:-${CURRENT:-}}")" \
        "$(json_str "${TARGET:-}")" "$(json_str "$(date -Iseconds)")" > "$tmpf"
    chmod 644 "$tmpf"; mv -f "$tmpf" "$STATUS_FILE"
}

git_in() { git -C "$INSTALL_DIR" "$@"; }
ver_of() { echo "${1#v}"; }
# a < b ?  (version comparison)
ver_lt() { [[ "$(ver_of "$1")" != "$(ver_of "$2")" && "$(printf '%s\n%s\n' "$(ver_of "$1")" "$(ver_of "$2")" | sort -V | head -1)" == "$(ver_of "$1")" ]]; }

CURRENT="v$(tr -d '[:space:]' < "$INSTALL_DIR/VERSION" 2>/dev/null || echo 0.0.0)"
CURRENT_COMMIT="$(git_in rev-parse HEAD)"

# ---------------------------------------------------------------- fetch releases
if ! git_in fetch --quiet --tags --force origin 2>>"$LOG_FILE"; then
    log "ERROR: could not reach GitHub (git fetch)"
    [[ "$MODE" == check ]] && printf '{"ok":false,"error":"GitHub unreachable","current":%s,"checked_at":%s}\n' \
        "$(json_str "$CURRENT")" "$(json_str "$(date -Iseconds)")" > "$CHECK_FILE" && chmod 644 "$CHECK_FILE"
    exit 2
fi
LATEST="$(git_in tag -l 'v[0-9]*.[0-9]*.[0-9]*' --sort=-v:refname | head -1)"

if [[ "$MODE" == check ]]; then
    available=false; notes=""
    if [[ -n "$LATEST" ]] && ver_lt "$CURRENT" "$LATEST"; then
        available=true
        # Notes of every release newer than the installed one (tag messages).
        while read -r t; do
            ver_lt "$CURRENT" "$t" || continue
            notes+="## ${t}"$'\n'"$(git_in tag -l --format='%(contents)' "$t")"$'\n\n'
        done < <(git_in tag -l 'v[0-9]*.[0-9]*.[0-9]*' --sort=-v:refname)
    fi
    printf '{"ok":true,"current":%s,"latest":%s,"available":%s,"notes":%s,"checked_at":%s}\n' \
        "$(json_str "$CURRENT")" "$(json_str "${LATEST:-}")" "$available" "$(json_str "$notes")" \
        "$(json_str "$(date -Iseconds)")" > "$CHECK_FILE"
    chmod 644 "$CHECK_FILE"
    echo "Installed: $CURRENT   Latest: ${LATEST:-none}   $([[ $available == true ]] && echo 'UPDATE AVAILABLE' || echo 'up to date')"
    exit 0
fi

# ------------------------------------------------------------------ target release
[[ -n "$TARGET" ]] || TARGET="$LATEST"
[[ "$TARGET" == v* ]] || TARGET="v$TARGET"
if [[ -z "$TARGET" || -z "$(git_in tag -l "$TARGET")" ]]; then
    echo "Release not found: ${TARGET:-(no tags)}" >&2; exit 1
fi
if ! ver_lt "$CURRENT" "$TARGET"; then
    echo "Installed version ($CURRENT) is already $TARGET or newer."; exit 0
fi

# ------------------------------------------------------------------ pre-checks
# Hand-edited code would be overwritten by the update.
dirty="$(git_in status --porcelain --untracked-files=no)"
if [[ -n "$dirty" ]]; then
    echo "Files under $INSTALL_DIR were modified; the update would discard them:" >&2
    echo "$dirty" >&2
    echo "Keep customisations out of the code: use the portal, /etc/ai-pbx.env and *_custom.conf files." >&2
    status failed "Code was modified by hand"
    exit 1
fi

calls="$(asterisk -rx 'core show channels count' 2>/dev/null | sed -n 's/^\([0-9]\+\) active call.*/\1/p')"
if [[ "${calls:-0}" -gt 0 && "$ALLOW_CALLS" != true ]]; then
    echo "${calls} call(s) in progress; the update restarts Asterisk and they would drop." >&2
    echo "Try again when the calls have ended, or force it with --allow-calls." >&2
    status failed "Calls in progress (${calls})"
    exit 3
fi

if [[ "$ASSUME_YES" != true ]]; then
    read -r -p "Update AiPBX $CURRENT → $TARGET? [y/N]: " ans
    [[ "${ans,,}" == y || "${ans,,}" == yes ]] || { echo "Cancelled."; exit 0; }
fi

log "===== Update started: $CURRENT → $TARGET ====="
status running "Taking a backup"

# ------------------------------------------------------------------ backup
BACKUP_DIR="$BACKUP_ROOT/$(date +%Y%m%d-%H%M%S)_${CURRENT}"
mkdir -p "$BACKUP_DIR"
echo "$CURRENT_COMMIT" > "$BACKUP_DIR/commit"
echo "$CURRENT" > "$BACKUP_DIR/version"
cp -p /etc/ai-pbx.env "$BACKUP_DIR/ai-pbx.env"
tar czf "$BACKUP_DIR/etc-asterisk.tgz" -C / etc/asterisk 2>>"$LOG_FILE"
mysqldump --single-transaction --routines --triggers --databases asterisk 2>>"$LOG_FILE" | gzip > "$BACKUP_DIR/asterisk-db.sql.gz"
if ! zcat "$BACKUP_DIR/asterisk-db.sql.gz" 2>/dev/null | tail -n 1 | grep -q 'Dump completed'; then
    log "ERROR: database backup failed, nothing was changed"
    status failed "Database backup failed"
    exit 1
fi
log "Backup: $BACKUP_DIR"
# Prune old backups (the last $KEEP_BACKUPS are kept)
ls -1dt "$BACKUP_ROOT"/*/ 2>/dev/null | tail -n +$((KEEP_BACKUPS + 1)) | xargs -r rm -rf

# ------------------------------------------------------------------ rollback
rollback() {
    log "!!! $1 — returning to the previous release ($CURRENT)"
    status running "Rolling back: $1"
    git_in checkout --quiet --force "$CURRENT_COMMIT" >>"$LOG_FILE" 2>&1
    # Restore the database exactly as backed up: tables added by the new
    # migrations are not in the dump, so the database is dropped first — but
    # ONLY when the dump is complete.
    if zcat "$BACKUP_DIR/asterisk-db.sql.gz" | tail -n 1 | grep -q 'Dump completed'; then
        if mysql -e 'DROP DATABASE IF EXISTS asterisk' 2>>"$LOG_FILE" \
           && zcat "$BACKUP_DIR/asterisk-db.sql.gz" | mysql 2>>"$LOG_FILE"; then
            log "Database restored from backup"
        else
            log "WARNING: database restore failed — by hand: zcat $BACKUP_DIR/asterisk-db.sql.gz | mysql"
        fi
    else
        log "WARNING: backup looks incomplete, database left untouched: $BACKUP_DIR"
    fi
    cp -p "$BACKUP_DIR/ai-pbx.env" /etc/ai-pbx.env
    bash "$INSTALL_DIR/install.sh" --upgrade >>"$LOG_FILE" 2>&1 \
        || log "WARNING: could not re-apply the previous release's system settings"
    log "===== Rolled back to $CURRENT ($1) ====="
    status rolled_back "$1"
    bash "$AIPBX_UPDATE_REEXEC" --check >/dev/null 2>&1 || true
    exit 1
}

# ------------------------------------------------------------------ apply
status running "Checking out $TARGET"
git_in checkout --quiet --force --detach "$TARGET" >>"$LOG_FILE" 2>&1 || rollback "Checkout failed"

status running "Updating the system (packages, database, services)"
log "Running install.sh --upgrade..."
bash "$INSTALL_DIR/install.sh" --upgrade >>"$LOG_FILE" 2>&1 || rollback "install.sh --upgrade failed"

# ------------------------------------------------------------------ verification
status running "Verifying"
sleep 3
for svc in mariadb apache2 nginx asterisk; do
    systemctl is-active --quiet "$svc" || rollback "$svc is not running"
done
domain="$(grep -m1 '^PORTAL_DOMAIN=' /etc/ai-pbx.env | cut -d= -f2-)"
code="$(curl -sk -o /dev/null -w '%{http_code}' --max-time 15 --resolve "${domain}:443:127.0.0.1" "https://${domain}/login")"
[[ "$code" == 200 ]] || rollback "Portal not responding (HTTP $code)"
if ! (cd "$INSTALL_DIR/web" && timeout 900 php bin/smoke.php >>"$LOG_FILE" 2>&1); then
    rollback "Page tests (smoke) failed"
fi

log "===== Update completed: $CURRENT → $TARGET ====="
FROM_VERSION="$CURRENT"
status done "Updated: $CURRENT → $TARGET"
# Refresh the portal's "update available" information.
bash "$AIPBX_UPDATE_REEXEC" --check >/dev/null 2>&1 || true
echo "AiPBX updated to $TARGET. Backup: $BACKUP_DIR"
