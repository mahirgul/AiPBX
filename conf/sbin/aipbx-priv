#!/bin/bash
# aipbx-priv — the ONLY command the AI PBX web portal may run as root.
#
# /etc/sudoers.d/aipbx grants www-data this script and nothing else. Before,
# asterisk/postconf/fail2ban-client/firewall-cmd were allowed without argument
# restrictions, so any code execution bug in the portal led straight to root
# (e.g. `sudo asterisk -C <fake.conf>`,
# `fail2ban-client set <jail> action ... actionban <komut>`,
# `postconf -e mailbox_command=...`). Here every subcommand maps to one fixed
# operation and every argument is validated against a strict pattern; no value
# ever reaches a shell.
#
# install.sh COPIES this file to /usr/local/sbin as root:root 0755 — it must
# never run from a location www-data can write to (e.g. under web/).

set -uo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

die() { echo "aipbx-priv: $*" >&2; exit 64; }

RE_JAIL='^[A-Za-z0-9_-]{1,64}$'
RE_IP='^[0-9A-Fa-f:.]{2,45}(/[0-9]{1,3})?$'
RE_IPV4_CIDR='^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?$'
RE_INT='^[0-9]{1,9}$'
RE_PORT='^[0-9]{1,5}(-[0-9]{1,5})?$'
RE_PROTO='^(tcp|udp)$'
RE_HOST='^[A-Za-z0-9.:_-]{1,253}$'
RE_RICH_RULE='^rule [A-Za-z0-9 ="./:_-]{1,400}$'
RE_EMAIL='^[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9.-]{1,253}$'

match() { [[ "$1" =~ $2 ]] || die "invalid value: $1"; }

# Optional last argument: only "--permanent" is accepted.
permanent_flag() {
    case "${1:-}" in
        '') ;;
        --permanent) echo --permanent ;;
        *) die "unexpected argument: $1" ;;
    esac
}

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
    service)
        # service restart|reload UNIT
        [ $# -eq 2 ] || die "usage: service restart|reload UNIT"
        case "$1" in restart|reload) ;; *) die "invalid operation: $1" ;; esac
        case "$2" in asterisk|apache2|mariadb|postfix|fail2ban|firewalld) ;; *) die "service not allowed: $2" ;; esac
        exec systemctl "$1" "$2"
        ;;

    postfix)
        sub="${1:-}"; [ $# -gt 0 ] && shift
        case "$sub" in
            relay)
                [ $# -eq 2 ] || die "usage: postfix relay HOST PORT"
                match "$1" "$RE_HOST"; match "$2" "$RE_INT"
                exec postconf -e "relayhost = [$1]:$2"
                ;;
            relay-clear)
                [ $# -eq 0 ] || die "usage: postfix relay-clear"
                exec postconf -e "relayhost ="
                ;;
            tls)
                # may/none: plain SMTP with optional STARTTLS (ports 25/587);
                # wrapper: TLS from the first byte (port 465, "SSL") — without
                # wrappermode postfix speaks plain SMTP there and times out.
                [ $# -eq 1 ] || die "usage: postfix tls may|none|wrapper"
                case "$1" in
                    may|none) exec postconf -e "smtp_tls_security_level = $1" "smtp_tls_wrappermode = no" ;;
                    wrapper)  exec postconf -e "smtp_tls_security_level = encrypt" "smtp_tls_wrappermode = yes" ;;
                    *) die "invalid value: $1" ;;
                esac
                ;;
            sasl)
                [ $# -eq 1 ] || die "usage: postfix sasl on|off"
                case "$1" in
                    on)  exec postconf -e "smtp_sasl_auth_enable = yes" \
                                          "smtp_sasl_security_options = noanonymous" \
                                          "smtp_sasl_password_maps = hash:/etc/postfix/sasl_passwd" ;;
                    off) exec postconf -e "smtp_sasl_auth_enable = no" ;;
                    *)   die "invalid value: $1" ;;
                esac
                ;;
            postmap)
                [ $# -eq 0 ] || die "usage: postfix postmap"
                exec postmap /etc/postfix/sasl_passwd
                ;;
            trace)
                # postfix trace TOKEN — delivery result of the message whose
                # Message-ID starts with TOKEN (the portal's test e-mail):
                # prints its "status=" log lines, nothing while it is pending.
                [ $# -eq 1 ] || die "usage: postfix trace TOKEN"
                match "$1" '^aipbx-test-[0-9a-f]{16}$'
                qid="$(journalctl -q --since=-15min -o cat -t postfix/cleanup 2>/dev/null \
                       | grep -F "message-id=<$1@" | tail -1 | cut -d: -f1)"
                [ -n "$qid" ] || exit 0
                match "$qid" '^[0-9A-Za-z]{6,20}$'
                journalctl -q --since=-15min -o cat -t postfix/smtp -t postfix/local \
                           -t postfix/error -t postfix/qmgr 2>/dev/null \
                    | grep -F "$qid: " | grep -E "status=|SASL|lost connection|timed out" | tail -5
                exit 0
                ;;
            *) die "unknown postfix command: $sub" ;;
        esac
        ;;

    fw)
        sub="${1:-}"; [ $# -gt 0 ] && shift
        case "$sub" in
            get-default-zone)
                [ $# -eq 0 ] || die "usage: fw get-default-zone"
                exec firewall-cmd --get-default-zone
                ;;
            list-all)
                [ $# -eq 0 ] || die "usage: fw list-all"
                exec firewall-cmd --list-all
                ;;
            add-port|remove-port)
                # fw add-port|remove-port PORT PROTO [--permanent]
                [ $# -eq 2 ] || [ $# -eq 3 ] || die "usage: fw $sub PORT PROTO [--permanent]"
                match "$1" "$RE_PORT"; match "$2" "$RE_PROTO"
                perm="$(permanent_flag "${3:-}")" || exit 64
                exec firewall-cmd "--$sub=$1/$2" ${perm:+"$perm"}
                ;;
            add-source-rule)
                # fw add-source-rule SUBNET PORT PROTO [--permanent]
                [ $# -eq 3 ] || [ $# -eq 4 ] || die "usage: fw add-source-rule SUBNET PORT PROTO [--permanent]"
                match "$1" "$RE_IPV4_CIDR"; match "$2" "$RE_PORT"; match "$3" "$RE_PROTO"
                perm="$(permanent_flag "${4:-}")" || exit 64
                exec firewall-cmd "--add-rich-rule=rule family=\"ipv4\" source address=\"$1\" port port=\"$2\" protocol=\"$3\" accept" ${perm:+"$perm"}
                ;;
            remove-rich-rule)
                # fw remove-rich-rule RULE [--permanent] — RULE is the text shown by `list-all`
                [ $# -eq 1 ] || [ $# -eq 2 ] || die "usage: fw remove-rich-rule RULE [--permanent]"
                match "$1" "$RE_RICH_RULE"
                perm="$(permanent_flag "${2:-}")" || exit 64
                exec firewall-cmd "--remove-rich-rule=$1" ${perm:+"$perm"}
                ;;
            *) die "unknown fw command: $sub" ;;
        esac
        ;;

    f2b)
        sub="${1:-}"; [ $# -gt 0 ] && shift
        case "$sub" in
            status)
                # f2b status [JAIL]
                [ $# -le 1 ] || die "usage: f2b status [JAIL]"
                [ $# -eq 1 ] && match "$1" "$RE_JAIL"
                exec fail2ban-client status "$@"
                ;;
            get)
                # f2b get JAIL bantime|findtime|maxretry|ignoreip
                [ $# -eq 2 ] || die "usage: f2b get JAIL KEY"
                match "$1" "$RE_JAIL"
                case "$2" in bantime|findtime|maxretry|ignoreip) ;; *) die "key not allowed: $2" ;; esac
                exec fail2ban-client get "$1" "$2"
                ;;
            set)
                # f2b set JAIL bantime|findtime|maxretry N
                # f2b set JAIL unbanip|addignoreip|delignoreip IP
                [ $# -eq 3 ] || die "usage: f2b set JAIL KEY VALUE"
                match "$1" "$RE_JAIL"
                case "$2" in
                    bantime|findtime|maxretry)       match "$3" "$RE_INT" ;;
                    unbanip|addignoreip|delignoreip) match "$3" "$RE_IP" ;;
                    *) die "key not allowed: $2" ;;
                esac
                exec fail2ban-client set "$1" "$2" "$3"
                ;;
            install-override)
                # Validates the persistent settings file staged by the panel and
                # installs it into jail.d. jail.d must stay root-owned: a jail file
                # can define commands to run, so a web-writable one meant root.
                [ $# -eq 0 ] || die "usage: f2b install-override"
                stage=/var/lib/aipbx/fail2ban-override.local
                tmp="$(mktemp)" || exit 1
                trap 'rm -f "$tmp"' EXIT
                # nofollow: a symlink must not make us read some other file.
                dd if="$stage" of="$tmp" iflag=nofollow bs=65536 count=1 status=none \
                    || die "staged file could not be read"
                [ "$(stat -c %s "$tmp")" -lt 65536 ] || die "staged file too large"
                n=0
                while IFS= read -r line || [ -n "$line" ]; do
                    n=$((n + 1))
                    [[ "$line" =~ ^$ ]] && continue
                    [[ "$line" =~ ^#[^[:cntrl:]]*$ ]] && continue
                    [[ "$line" =~ ^\[(DEFAULT|[A-Za-z0-9_-]{1,64})\]$ ]] && continue
                    [[ "$line" =~ ^ignoreip\ =\ [0-9A-Fa-f:./\ ]{1,4000}$ ]] && continue
                    [[ "$line" =~ ^(bantime|findtime|maxretry)\ =\ [0-9]{1,9}$ ]] && continue
                    # Only the line number is reported, never its content.
                    die "line not allowed in staged file: $n"
                done < "$tmp"
                # zz-: fail2ban reads jail.d in name order and this must win.
                install -o root -g root -m 0644 "$tmp" /etc/fail2ban/jail.d/zz-ai-pbx.local
                rm -f /etc/fail2ban/jail.d/99-ai-pbx.local
                ;;
            *) die "unknown f2b command: $sub" ;;
        esac
        ;;

    cert)
        # Certificates page. aipbx-cert runs in its own systemd unit: Apache's
        # sandbox keeps /etc read-only, and certbot --apache must edit the
        # Apache configuration while it validates. --wait --pipe returns its
        # output and exit code; the fixed unit name stops parallel runs.
        sub="${1:-}"; [ $# -gt 0 ] && shift
        case "$sub" in
            letsencrypt)
                # cert letsencrypt [--dry-run] [--email ADDR]
                args=()
                while [ $# -gt 0 ]; do
                    case "$1" in
                        --dry-run) args+=(--dry-run) ;;
                        --email) [ $# -ge 2 ] || die "usage: cert letsencrypt [--dry-run] [--email ADDR]"
                            match "$2" "$RE_EMAIL"; args+=(--email "$2"); shift ;;
                        *) die "unexpected argument: $1" ;;
                    esac
                    shift
                done
                ;;
            renew)
                # cert renew [--dry-run]
                [ $# -le 1 ] || die "usage: cert renew [--dry-run]"
                case "${1:-}" in '') args=() ;; --dry-run) args=(--dry-run) ;; *) die "unexpected argument: $1" ;; esac
                ;;
            custom)
                # cert custom [--allow-mismatch] — files staged in /var/lib/aipbx/cert-stage
                [ $# -le 1 ] || die "usage: cert custom [--allow-mismatch]"
                case "${1:-}" in '') args=() ;; --allow-mismatch) args=(--allow-mismatch) ;; *) die "unexpected argument: $1" ;; esac
                ;;
            selfsigned)
                [ $# -eq 0 ] || die "usage: cert selfsigned"
                args=()
                ;;
            *) die "unknown cert command: $sub" ;;
        esac
        if systemctl is-active --quiet aipbx-cert.service; then
            die "a certificate operation is already running"
        fi
        systemctl reset-failed aipbx-cert.service >/dev/null 2>&1 || true
        exec systemd-run --quiet --wait --pipe --collect --unit=aipbx-cert \
            --description="AiPBX certificate: $sub" /usr/local/sbin/aipbx-cert "$sub" ${args[@]+"${args[@]}"}
        ;;

    update)
        # System Update page: version check and starting an update. The update
        # runs in the background as a separate systemd unit (the portal's Apache
        # is restarted during it, so it cannot run inside a request); progress
        # is read from /var/lib/aipbx/update-status.json.
        sub="${1:-}"; [ $# -gt 0 ] && shift
        case "$sub" in
            check)
                [ $# -eq 0 ] || die "usage: update check"
                exec /usr/local/sbin/aipbx-update --check
                ;;
            start)
                # update start [--allow-calls]
                [ $# -le 1 ] || die "usage: update start [--allow-calls]"
                extra=""
                case "${1:-}" in '') ;; --allow-calls) extra="--allow-calls" ;; *) die "unexpected argument: $1" ;; esac
                if systemctl is-active --quiet aipbx-update.service; then
                    die "an update is already running"
                fi
                systemctl reset-failed aipbx-update.service >/dev/null 2>&1 || true
                exec systemd-run --quiet --collect --unit=aipbx-update \
                    --setenv=HOME=/root \
                    --description="AiPBX update" /usr/local/sbin/aipbx-update --yes $extra
                ;;
            *) die "unknown update command: $sub" ;;
        esac
        ;;

    sounds)
        # Sounds page → Asterisk sound packs: sounds install|remove KIND LANG FORMAT.
        # Downloading can take minutes, so it runs in its own systemd unit;
        # progress is read from /var/lib/aipbx/sound-packs-status.json.
        [ $# -eq 4 ] || die "usage: sounds install|remove KIND LANG FORMAT"
        case "$1" in install|remove) ;; *) die "invalid operation: $1" ;; esac
        case "$2" in core|extra|moh) ;; *) die "invalid kind: $2" ;; esac
        match "$3" '^([a-z]{2}(_[A-Z]{2})?|opsound)$'
        case "$4" in wav|ulaw|alaw|gsm|g722|sln16) ;; *) die "invalid format: $4" ;; esac
        if systemctl is-active --quiet aipbx-sounds.service; then
            die "a sound pack operation is already running"
        fi
        systemctl reset-failed aipbx-sounds.service >/dev/null 2>&1 || true
        exec systemd-run --quiet --collect --unit=aipbx-sounds \
            --description="AiPBX sound pack: $1 $2-$3-$4" /usr/local/sbin/aipbx-sounds "$1" "$2" "$3" "$4"
        ;;

    asterisk-lang)
        # asterisk-lang LANG — [options] defaultlanguage in asterisk.conf (the
        # file is asterisk:asterisk 0640, the portal cannot write it). Takes
        # effect after a full Asterisk restart.
        [ $# -eq 1 ] || die "usage: asterisk-lang LANG"
        match "$1" '^[A-Za-z]{2,3}(_[A-Za-z]{2,4})?$'
        conf=/etc/asterisk/asterisk.conf
        [ -f "$conf" ] || die "$conf not found"
        # An active line wins; else uncomment the sample line; else add one.
        for re in '^defaultlanguage[[:space:]]*=.*' '^;[[:space:]]*defaultlanguage[[:space:]]*=.*'; do
            if grep -q "$re" "$conf"; then
                exec sed -i "0,/$re/s//defaultlanguage = $1/" "$conf"
            fi
        done
        exec sed -i "/^\[options\]/a defaultlanguage = $1" "$conf"
        ;;

    netsvc)
        # PBX → Network services (roadmap 10): dnsmasq as a DHCP server for a
        # phone network and/or a TFTP server, in its own unit (aipbx-dnsmasq).
        # The configuration is written HERE from validated KEY=VALUE arguments,
        # into a root-owned folder: a dnsmasq file can run commands as root
        # (dhcp-script), so the portal must never be able to write one.
        NETSVC_DIR=/var/lib/aipbx-netsvc
        NETSVC_CONF="$NETSVC_DIR/dnsmasq.conf"
        NETSVC_FW="$NETSVC_DIR/firewall.state"
        RE_IPV4='^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$'
        RE_IFACE='^[A-Za-z0-9][A-Za-z0-9._-]{0,14}$'
        RE_ZONE='^[A-Za-z0-9_-]{1,32}$'
        RE_PROV_URL='^https?://[A-Za-z0-9.-]{1,253}(:[0-9]{1,5})?/provision/$'

        fw_running() { firewall-cmd --state >/dev/null 2>&1; }
        # firewall-cmd, retried once after a reload: a change that failed half way leaves
        # firewalld's runtime state broken ("COMMAND_FAILED: 'handle'") until it is reloaded.
        fw_add() { firewall-cmd "$@" >/dev/null 2>&1 || { firewall-cmd --reload >/dev/null 2>&1; firewall-cmd "$@" >/dev/null; }; }
        # UDP 69 only: the firewalld "tftp" service needs the nf_conntrack_tftp kernel module,
        # which is missing in containers and some kernels; a TFTP server does not need it
        # (its replies open the conntrack entries the client's packets match).
        tftp_rule() { echo "rule family=\"ipv4\" source address=\"$1\" port port=\"69\" protocol=\"udp\" accept"; }
        tftp_rule_old() { echo "rule family=\"ipv4\" source address=\"$1\" service name=\"tftp\" accept"; }

        # Removes the firewall openings of the last apply (listed in the state file).
        netsvc_fw_clear() {
            [ -f "$NETSVC_FW" ] || return 0
            if fw_running; then
                while read -r kind value; do
                    case "$kind" in
                        tftp) [[ "$value" =~ $RE_IPV4_CIDR ]] || continue
                            for p in "" --permanent; do
                                firewall-cmd $p --remove-rich-rule="$(tftp_rule "$value")" >/dev/null 2>&1
                                # Rule of releases up to 1.15 (the tftp service).
                                firewall-cmd $p --remove-rich-rule="$(tftp_rule_old "$value")" >/dev/null 2>&1
                            done ;;
                        dhcp) [[ "$value" =~ $RE_ZONE ]] || continue
                            for p in "" --permanent; do firewall-cmd $p --zone="$value" --remove-service=dhcp >/dev/null 2>&1; done ;;
                    esac
                done < "$NETSVC_FW"
            fi
            rm -f "$NETSVC_FW"
        }

        FTP_FW="$NETSVC_DIR/ftp-firewall.state"
        ftp_rule() { echo "rule family=\"ipv4\" source address=\"$1\" port port=\"$2\" protocol=\"tcp\" accept"; }
        ftp_fw_clear() {
            [ -f "$FTP_FW" ] || return 0
            if fw_running; then
                while read -r kind value; do
                    [ "$kind" = ftp ] && [[ "$value" =~ $RE_IPV4_CIDR ]] || continue
                    for r in "$(ftp_rule "$value" 21)" "$(ftp_rule "$value" 40000-40049)"; do
                        for p in "" --permanent; do firewall-cmd $p --remove-rich-rule="$r" >/dev/null 2>&1; done
                    done
                done < "$FTP_FW"
            fi
            rm -f "$FTP_FW"
        }

        SYSLOG_FW="$NETSVC_DIR/syslog-firewall.state"
        syslog_rule() { echo "rule family=\"ipv4\" source address=\"$1\" port port=\"514\" protocol=\"udp\" accept"; }
        syslog_fw_clear() {
            [ -f "$SYSLOG_FW" ] || return 0
            if fw_running; then
                while read -r kind value; do
                    [ "$kind" = syslog ] && [[ "$value" =~ $RE_IPV4_CIDR ]] || continue
                    for p in "" --permanent; do firewall-cmd $p --remove-rich-rule="$(syslog_rule "$value")" >/dev/null 2>&1; done
                done < "$SYSLOG_FW"
            fi
            rm -f "$SYSLOG_FW"
        }

        NTP_CONF=/etc/chrony/conf.d/aipbx-ntp-server.conf
        NTP_FW="$NETSVC_DIR/ntp-firewall.state"
        ntp_rule() { echo "rule family=\"ipv4\" source address=\"$1\" port port=\"123\" protocol=\"udp\" accept"; }
        ntp_fw_clear() {
            [ -f "$NTP_FW" ] || return 0
            if fw_running; then
                while read -r kind value; do
                    [ "$kind" = ntp ] && [[ "$value" =~ $RE_IPV4_CIDR ]] || continue
                    for p in "" --permanent; do firewall-cmd $p --remove-rich-rule="$(ntp_rule "$value")" >/dev/null 2>&1; done
                done < "$NTP_FW"
            fi
            rm -f "$NTP_FW"
        }

        sub="${1:-}"; [ $# -gt 0 ] && shift
        case "$sub" in
            status)
                [ $# -eq 0 ] || die "usage: netsvc status"
                systemctl is-active aipbx-dnsmasq.service 2>/dev/null
                exit 0
                ;;
            probe)
                # netsvc probe IFACE — DHCP servers answering on IFACE (DHCPDISCOVER).
                [ $# -eq 1 ] || die "usage: netsvc probe IFACE"
                match "$1" "$RE_IFACE"
                [ -e "/sys/class/net/$1" ] || die "no such interface: $1"
                exec /usr/local/sbin/aipbx-dhcp-probe "$1"
                ;;
            off)
                [ $# -eq 0 ] || die "usage: netsvc off"
                systemctl stop aipbx-dnsmasq.service >/dev/null 2>&1
                rm -f "$NETSVC_CONF"
                netsvc_fw_clear
                exit 0
                ;;
            apply)
                # netsvc apply mode=tftp|dhcp [iface=] [start= end= mask= gw= lease=HOURS]
                #   [dns=IP,IP] [ntp=IP,IP] [url=http(s)://HOST/provision/] [tftp=0|1] [net=CIDR]...
                #   [opt=CODE,VALUE]...  (extra DHCP options; the same code replaces AiPBX's own)
                mode=""; iface=""; start=""; end=""; mask=""; gw=""; lease=""; dns=""; ntp=""; url=""; tftp=1
                nets=(); opts=(); declare -A optcode=()
                for kv in "$@"; do
                    k="${kv%%=*}"; v="${kv#*=}"
                    [ "$k" != "$kv" ] || die "expected KEY=VALUE: $kv"
                    case "$k" in
                        mode) case "$v" in tftp|dhcp) mode="$v" ;; *) die "invalid mode: $v" ;; esac ;;
                        iface) match "$v" "$RE_IFACE"; iface="$v" ;;
                        start) match "$v" "$RE_IPV4"; start="$v" ;;
                        end) match "$v" "$RE_IPV4"; end="$v" ;;
                        mask) match "$v" "$RE_IPV4"; mask="$v" ;;
                        gw) match "$v" "$RE_IPV4"; gw="$v" ;;
                        lease) match "$v" '^([1-9]|[1-9][0-9]|1[0-6][0-9])$'; lease="$v" ;;
                        dns|ntp)
                            IFS=',' read -r -a list <<< "$v"
                            [ "${#list[@]}" -ge 1 ] && [ "${#list[@]}" -le 3 ] || die "invalid $k list"
                            for ip in "${list[@]}"; do match "$ip" "$RE_IPV4"; done
                            [ "$k" = dns ] && dns="$v" || ntp="$v" ;;
                        url) match "$v" "$RE_PROV_URL"; url="$v" ;;
                        opt)
                            # CODE 1-254, a value without quotes, #, backslash or line breaks.
                            match "$v" '^([1-9][0-9]?|1[0-9][0-9]|2[0-4][0-9]|25[0-4]),[A-Za-z0-9 .:/_@,+=%~!$&()*;?-]{1,200}$'
                            [ "${#opts[@]}" -lt 20 ] || die "too many DHCP options"
                            opts+=("$v"); optcode["${v%%,*}"]=1 ;;
                        tftp) case "$v" in 0|1) tftp="$v" ;; *) die "invalid tftp: $v" ;; esac ;;
                        net) match "$v" "$RE_IPV4_CIDR"; [ "${#nets[@]}" -lt 32 ] || die "too many networks"; nets+=("$v") ;;
                        *) die "unknown key: $k" ;;
                    esac
                done
                [ -n "$mode" ] || die "mode= is required"
                if [ "$mode" = tftp ]; then
                    tftp=1
                else
                    [ -n "$iface" ] && [ -n "$start" ] && [ -n "$end" ] && [ -n "$mask" ] && [ -n "$lease" ] \
                        || die "dhcp needs iface, start, end, mask and lease"
                    [ -e "/sys/class/net/$iface" ] || die "no such interface: $iface"
                fi
                # TFTP answers only the configured local networks (firewall).
                [ "$tftp" = 0 ] || [ "${#nets[@]}" -gt 0 ] || die "tftp needs at least one net="

                user=nobody
                id -u dnsmasq >/dev/null 2>&1 && user=dnsmasq
                mkdir -p "$NETSVC_DIR"
                [ -d /var/lib/aipbx/tftp ] || install -d -o www-data -g www-data -m 0755 /var/lib/aipbx/tftp
                chown root:root "$NETSVC_DIR"; chmod 0755 "$NETSVC_DIR"
                tmp="$(mktemp "$NETSVC_DIR/.dnsmasq.XXXXXX")" || exit 1
                trap 'rm -f "$tmp"' EXIT
                {
                    echo "# Written by aipbx-priv (PBX -> Network services). Do not edit: the next apply replaces it."
                    echo "port=0"
                    echo "user=$user"
                    if [ "$mode" = dhcp ]; then
                        echo "interface=$iface"
                        echo "bind-dynamic"
                        echo "dhcp-range=$start,$end,$mask,${lease}h"
                        echo "dhcp-leasefile=$NETSVC_DIR/dnsmasq.leases"
                        [ -n "$gw" ] && [ -z "${optcode[3]:-}" ] && echo "dhcp-option=option:router,$gw"
                        [ -n "$dns" ] && [ -z "${optcode[6]:-}" ] && echo "dhcp-option=option:dns-server,$dns"
                        [ -n "$ntp" ] && [ -z "${optcode[42]:-}" ] && echo "dhcp-option=option:ntp-server,$ntp"
                        if [ -n "$url" ]; then
                            # 66: Yealink, Grandstream, Fanvil, Snom, Cisco; 160: Poly.
                            [ -z "${optcode[66]:-}" ] && echo "dhcp-option=66,\"$url\""
                            [ -z "${optcode[160]:-}" ] && echo "dhcp-option=160,\"$url\""
                        fi
                        # 150: Cisco TFTP server; 0.0.0.0 = this server.
                        [ "$tftp" = 1 ] && [ -z "${optcode[150]:-}" ] && echo "dhcp-option=150,0.0.0.0"
                        # Extra options are sent even when the phone does not ask for them.
                        for o in "${opts[@]}"; do echo "dhcp-option-force=$o"; done
                    fi
                    if [ "$tftp" = 1 ]; then
                        echo "enable-tftp"
                        echo "tftp-root=/var/lib/aipbx/tftp"
                    fi
                } > "$tmp"
                dnsmasq --test --conf-file="$tmp" >/dev/null 2>&1 || die "dnsmasq rejected the configuration"
                install -o root -g root -m 0644 "$tmp" "$NETSVC_CONF"

                netsvc_fw_clear
                if fw_running; then
                    : > "$NETSVC_FW"
                    if [ "$tftp" = 1 ]; then
                        for n in "${nets[@]}"; do
                            for p in "" --permanent; do fw_add $p --add-rich-rule="$(tftp_rule "$n")" || die "firewall: tftp $n"; done
                            echo "tftp $n" >> "$NETSVC_FW"
                        done
                    fi
                    if [ "$mode" = dhcp ]; then
                        # UDP 67 in the zone of the chosen interface only.
                        zone="$(firewall-cmd --get-zone-of-interface="$iface" 2>/dev/null || firewall-cmd --get-default-zone)"
                        match "$zone" "$RE_ZONE"
                        for p in "" --permanent; do fw_add $p --zone="$zone" --add-service=dhcp || die "firewall: dhcp $zone"; done
                        echo "dhcp $zone" >> "$NETSVC_FW"
                    fi
                fi
                rm -f "$tmp"
                exec systemctl restart aipbx-dnsmasq.service
                ;;
            ftp-on)
                # netsvc ftp-on [user=NAME:CRYPT]... [anonymous=0|1] net=CIDR...
                # Read-only FTP (vsftpd, unit aipbx-vsftpd) of the TFTP folder for
                # phones that fetch their files over FTP (e.g. NEC DT700: user
                # NECSDT700). Every user, NECSDT700 included, logs in with a
                # password from ftp.passwd (pam_pwdfile, guest = ftp; no system
                # accounts) and may only read. Anonymous login (no password) only
                # with anonymous=1 (the page's switch, off by default): the folder
                # holds the phones' files with their SIP passwords.
                ftpusers=(); nets=(); anon=0
                for kv in "$@"; do
                    k="${kv%%=*}"; v="${kv#*=}"
                    [ "$k" != "$kv" ] || die "expected KEY=VALUE: $kv"
                    case "$k" in
                        user) match "$v" '^[A-Za-z0-9._-]{1,32}:\$6\$[A-Za-z0-9./]{1,16}\$[A-Za-z0-9./]{86}$'
                            [ "${#ftpusers[@]}" -lt 21 ] || die "too many FTP users"; ftpusers+=("$v") ;;
                        anonymous) case "$v" in 0|1) anon="$v" ;; *) die "invalid anonymous: $v" ;; esac ;;
                        net) match "$v" "$RE_IPV4_CIDR"; [ "${#nets[@]}" -lt 32 ] || die "too many networks"; nets+=("$v") ;;
                        *) die "unknown key: $k" ;;
                    esac
                done
                [ "${#nets[@]}" -gt 0 ] || die "ftp needs at least one net="
                [ -x /usr/sbin/vsftpd ] || die "vsftpd is not installed (run install.sh --upgrade)"
                id -u ftp >/dev/null 2>&1 || die "the ftp system user is missing"

                mkdir -p "$NETSVC_DIR"; chown root:root "$NETSVC_DIR"; chmod 0755 "$NETSVC_DIR"
                [ -d /var/lib/aipbx/tftp ] || install -d -o www-data -g www-data -m 0755 /var/lib/aipbx/tftp
                install -d -o root -g root -m 0755 /var/run/vsftpd/empty
                umask 077
                # FTP users with their password hashes (NECSDT700 and the extra ones).
                : > "$NETSVC_DIR/ftp.passwd.tmp"
                [ "${#ftpusers[@]}" -eq 0 ] || printf '%s\n' "${ftpusers[@]}" > "$NETSVC_DIR/ftp.passwd.tmp"
                install -o root -g root -m 0600 "$NETSVC_DIR/ftp.passwd.tmp" "$NETSVC_DIR/ftp.passwd"
                rm -f "$NETSVC_DIR/ftp.passwd.tmp"
                umask 022
                cat > "$NETSVC_DIR/vsftpd.conf.tmp" << 'FTPCONF'
# Written by aipbx-priv (PBX -> Network services). Do not edit: the next apply replaces it.
listen=YES
listen_ipv6=NO
background=NO
ftpd_banner=AiPBX
# Read only. Anonymous login only when switched on (the folder holds the
# phones' SIP passwords).
write_enable=NO
anonymous_enable=NO
anon_upload_enable=NO
anon_mkdir_write_enable=NO
anon_other_write_enable=NO
no_anon_password=YES
anon_root=/var/lib/aipbx/tftp
anon_world_readable_only=YES
# The users: checked against ftp.passwd (PAM aipbx-ftp), then mapped to "ftp".
local_enable=YES
guest_enable=YES
guest_username=ftp
local_root=/var/lib/aipbx/tftp
chroot_local_user=YES
pam_service_name=aipbx-ftp
hide_ids=YES
secure_chroot_dir=/var/run/vsftpd/empty
pasv_enable=YES
pasv_min_port=40000
pasv_max_port=40049
xferlog_enable=YES
vsftpd_log_file=/var/log/aipbx-ftp.log
FTPCONF
                [ "$anon" = 1 ] && sed -i 's/^anonymous_enable=NO$/anonymous_enable=YES/' "$NETSVC_DIR/vsftpd.conf.tmp"
                install -o root -g root -m 0644 "$NETSVC_DIR/vsftpd.conf.tmp" "$NETSVC_DIR/vsftpd.conf"
                rm -f "$NETSVC_DIR/vsftpd.conf.tmp"

                # Port 21 and the passive ports, from the allowed networks only.
                ftp_fw_clear
                if fw_running; then
                    : > "$FTP_FW"
                    for n in "${nets[@]}"; do
                        for r in "$(ftp_rule "$n" 21)" "$(ftp_rule "$n" 40000-40049)"; do
                            for p in "" --permanent; do fw_add $p --add-rich-rule="$r" || die "firewall: ftp $n"; done
                        done
                        echo "ftp $n" >> "$FTP_FW"
                    done
                fi
                systemctl enable aipbx-vsftpd.service >/dev/null 2>&1
                exec systemctl restart aipbx-vsftpd.service
                ;;
            ftp-off)
                [ $# -eq 0 ] || die "usage: netsvc ftp-off"
                systemctl stop aipbx-vsftpd.service >/dev/null 2>&1
                rm -f "$NETSVC_DIR/vsftpd.conf" "$NETSVC_DIR/ftp.passwd"
                ftp_fw_clear
                exit 0
                ;;
            log)
                # netsvc log ftp|tftp|dhcp — the newest lines of what the phones
                # fetched (PBX -> Phone logs). Read only: FTP's transfer log
                # (root 0600), TFTP and DHCP from dnsmasq's journal.
                [ $# -eq 1 ] || die "usage: netsvc log ftp|tftp|dhcp"
                case "$1" in
                    ftp) [ -f /var/log/aipbx-ftp.log ] || exit 0
                         exec tail -n 2000 /var/log/aipbx-ftp.log ;;
                    tftp) exec journalctl -u aipbx-dnsmasq.service -t dnsmasq-tftp -n 2000 -o short-iso --no-pager -q ;;
                    dhcp) exec journalctl -u aipbx-dnsmasq.service -t dnsmasq-dhcp -n 2000 -o short-iso --no-pager -q ;;
                    *) die "invalid log: $1" ;;
                esac
                ;;
            ftp-status)
                [ $# -eq 0 ] || die "usage: netsvc ftp-status"
                systemctl is-active aipbx-vsftpd.service 2>/dev/null
                exit 0
                ;;
            syslog-on)
                # netsvc syslog-on net=CIDR... — receive the phones' logs (syslog,
                # UDP 514) from the allowed networks into /var/log/aipbx-phones/
                # (PBX -> Phone logs): aipbx-syslogd (unit aipbx-syslog), which also
                # drops senders outside these networks itself.
                nets=()
                for kv in "$@"; do
                    k="${kv%%=*}"; v="${kv#*=}"
                    [ "$k" != "$kv" ] || die "expected KEY=VALUE: $kv"
                    case "$k" in
                        net) match "$v" "$RE_IPV4_CIDR"; [ "${#nets[@]}" -lt 32 ] || die "too many networks"; nets+=("$v") ;;
                        *) die "unknown key: $k" ;;
                    esac
                done
                [ "${#nets[@]}" -gt 0 ] || die "syslog needs at least one net="
                [ -x /usr/local/sbin/aipbx-syslogd ] || die "aipbx-syslogd is missing (run install.sh --upgrade)"
                mkdir -p "$NETSVC_DIR"; chown root:root "$NETSVC_DIR"; chmod 0755 "$NETSVC_DIR"
                {
                    echo "# Written by aipbx-priv (PBX -> Network services). Do not edit: the next apply replaces it."
                    printf 'net=%s\n' "${nets[@]}"
                } > "$NETSVC_DIR/syslog.conf.tmp"
                install -o root -g root -m 0644 "$NETSVC_DIR/syslog.conf.tmp" "$NETSVC_DIR/syslog.conf"
                rm -f "$NETSVC_DIR/syslog.conf.tmp"

                syslog_fw_clear
                if fw_running; then
                    : > "$SYSLOG_FW"
                    for n in "${nets[@]}"; do
                        for p in "" --permanent; do fw_add $p --add-rich-rule="$(syslog_rule "$n")" || die "firewall: syslog $n"; done
                        echo "syslog $n" >> "$SYSLOG_FW"
                    done
                fi
                systemctl enable aipbx-syslog.service >/dev/null 2>&1
                exec systemctl restart aipbx-syslog.service
                ;;
            syslog-off)
                [ $# -eq 0 ] || die "usage: netsvc syslog-off"
                systemctl disable --now aipbx-syslog.service >/dev/null 2>&1
                rm -f "$NETSVC_DIR/syslog.conf"
                syslog_fw_clear
                exit 0
                ;;
            syslog-status)
                [ $# -eq 0 ] || die "usage: netsvc syslog-status"
                systemctl is-active aipbx-syslog.service 2>/dev/null
                exit 0
                ;;
            ntp-on)
                # netsvc ntp-on net=CIDR... — this server gives the time (NTP, UDP 123)
                # to the allowed networks: chrony (the system's own time sync) gets
                # "allow" lines for them, and keeps serving from its own clock when
                # the internet sources are unreachable (local stratum 10).
                nets=()
                for kv in "$@"; do
                    k="${kv%%=*}"; v="${kv#*=}"
                    [ "$k" != "$kv" ] || die "expected KEY=VALUE: $kv"
                    case "$k" in
                        net) match "$v" "$RE_IPV4_CIDR"; [ "${#nets[@]}" -lt 32 ] || die "too many networks"; nets+=("$v") ;;
                        *) die "unknown key: $k" ;;
                    esac
                done
                [ "${#nets[@]}" -gt 0 ] || die "ntp needs at least one net="
                command -v chronyd >/dev/null 2>&1 && [ -d /etc/chrony/conf.d ] || die "chrony is not installed"
                {
                    echo "# Written by aipbx-priv (PBX -> Network services). Do not edit: the next apply replaces it."
                    printf 'allow %s\n' "${nets[@]}"
                    echo "local stratum 10"
                } > "$NTP_CONF.tmp"
                install -o root -g root -m 0644 "$NTP_CONF.tmp" "$NTP_CONF"
                rm -f "$NTP_CONF.tmp"
                mkdir -p "$NETSVC_DIR"
                ntp_fw_clear
                if fw_running; then
                    : > "$NTP_FW"
                    for n in "${nets[@]}"; do
                        for p in "" --permanent; do fw_add $p --add-rich-rule="$(ntp_rule "$n")" || die "firewall: ntp $n"; done
                        echo "ntp $n" >> "$NTP_FW"
                    done
                fi
                exec systemctl restart chrony.service
                ;;
            ntp-off)
                [ $# -eq 0 ] || die "usage: netsvc ntp-off"
                ntp_fw_clear
                if [ -f "$NTP_CONF" ]; then
                    rm -f "$NTP_CONF"
                    systemctl restart chrony.service >/dev/null 2>&1
                fi
                exit 0
                ;;
            ntp-status)
                # active = chrony runs and serves the networks (the allow file is there).
                [ $# -eq 0 ] || die "usage: netsvc ntp-status"
                if [ -f "$NTP_CONF" ]; then systemctl is-active chrony.service 2>/dev/null; else echo inactive; fi
                exit 0
                ;;
            *) die "unknown netsvc command: $sub" ;;
        esac
        ;;

    ai)
        # AI → Local models (roadmap 5): the runtime of the local AI service
        # (Python venv with torch, about 1 GB) and its unit. Installing
        # takes minutes, so it runs detached in its own unit; progress is read
        # with `ai runtime-status` (/var/lib/aipbx-ai/runtime.json). Models
        # themselves are managed over the service's own API (127.0.0.1:8790).
        sub="${1:-}"; [ $# -gt 0 ] && shift
        [ $# -eq 0 ] || die "usage: ai runtime-install|runtime-remove|runtime-status|restart"
        case "$sub" in
            runtime-install|runtime-remove)
                if systemctl is-active --quiet aipbx-ai-setup.service; then
                    die "an AI runtime operation is already running"
                fi
                systemctl reset-failed aipbx-ai-setup.service >/dev/null 2>&1 || true
                if [ "$sub" = runtime-install ]; then
                    exec systemd-run --quiet --collect --unit=aipbx-ai-setup \
                        --description="AiPBX AI runtime: install" /usr/local/sbin/aipbx-ai-setup install
                fi
                # Seconds only, but outside Apache's sandbox like everything
                # that deletes under /opt; --wait returns its result.
                exec systemd-run --quiet --wait --pipe --collect --unit=aipbx-ai-setup \
                    --description="AiPBX AI runtime: remove" /usr/local/sbin/aipbx-ai-setup remove
                ;;
            runtime-status)
                exec /usr/local/sbin/aipbx-ai-setup status
                ;;
            restart)
                [ -x /opt/aipbx-ai/venv/bin/python ] || die "the AI runtime is not installed"
                exec systemctl restart aipbx-ai.service
                ;;
            *) die "unknown ai command: $sub" ;;
        esac
        ;;

    net)
        # The server's own address in the files outside the database (PBX ->
        # Network settings, roadmap 12): coturn, the mDNS alias and a
        # self-signed certificate. The database side is the portal's.
        [ $# -ge 1 ] || die "usage: net status|readdress"
        sub="$1"; shift
        ipv4() { [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || die "invalid address: $1"; }
        case "$sub" in
            status)
                # net status — key=value lines, read only.
                [ $# -eq 0 ] || die "usage: net status"
                echo "addresses=$(hostname -I 2>/dev/null | xargs)"
                if [ -r /etc/turnserver.conf ]; then
                    echo "coturn_relay=$(awk -F= '/^relay-ip=/{print $2}' /etc/turnserver.conf | head -1)"
                    echo "coturn_allowed=$(awk -F= '/^allowed-peer-ip=/{printf "%s ", $2}' /etc/turnserver.conf | xargs)"
                fi
                if [ -r /etc/systemd/system/aipbx-mdns.service ]; then
                    echo "mdns=$(awk '/^ExecStart=/{print $NF}' /etc/systemd/system/aipbx-mdns.service)"
                fi
                if [ -r /etc/ssl/aipbx/mode ] && [ "$(cat /etc/ssl/aipbx/mode)" = selfsigned ] && [ -r /etc/ssl/aipbx/aipbx.crt ]; then
                    echo "cert_ips=$(openssl x509 -noout -ext subjectAltName -in /etc/ssl/aipbx/aipbx.crt 2>/dev/null | grep -oE 'IP Address:[0-9.]+' | cut -d: -f2 | xargs)"
                fi
                exit 0
                ;;
            readdress)
                # net readdress old=IP new=IP — runs readdress-run below in a
                # transient unit: Apache's sandbox (ProtectSystem=full) keeps /etc
                # read-only for the portal and for this script started by it, so
                # coturn, the mDNS unit and the certificate could not be written
                # from the portal (they could from the command line).
                for kv in "$@"; do
                    case "${kv%%=*}" in old|new) ipv4 "${kv#*=}" ;; *) die "unknown key: ${kv%%=*}" ;; esac
                done
                [ $# -eq 2 ] || die "usage: net readdress old=IP new=IP"
                if systemctl is-active --quiet aipbx-readdress.service; then
                    die "an address change is already running"
                fi
                systemctl reset-failed aipbx-readdress.service >/dev/null 2>&1 || true
                exec systemd-run --quiet --wait --pipe --collect --unit=aipbx-readdress \
                    --description="AiPBX: server address change" /usr/local/sbin/aipbx-priv net readdress-run "$@"
                ;;
            readdress-run)
                # net readdress-run old=IP new=IP — puts the new address where the old
                # one was: coturn relay-ip (and allowed-peer-ip = every address of
                # this server), the mDNS alias, a self-signed certificate naming the
                # old IP. coturn restarts once no call is up (a restart drops calls
                # that go through TURN); everything else at once.
                old=""; new=""
                for kv in "$@"; do
                    k="${kv%%=*}"; v="${kv#*=}"
                    case "$k" in
                        old) ipv4 "$v"; old="$v" ;;
                        new) ipv4 "$v"; new="$v" ;;
                        *) die "unknown key: $k" ;;
                    esac
                done
                [ -n "$old" ] && [ -n "$new" ] && [ "$old" != "$new" ] || die "usage: net readdress old=IP new=IP"
                if [ -f /etc/turnserver.conf ]; then
                    cp -p /etc/turnserver.conf "/etc/turnserver.conf.before-readdress"
                    sed -i "s/^relay-ip=${old//./\\.}\$/relay-ip=${new}/" /etc/turnserver.conf
                    sed -i '/^allowed-peer-ip=/d' /etc/turnserver.conf
                    for ip in $(hostname -I); do echo "allowed-peer-ip=$ip"; done >> /etc/turnserver.conf
                    systemctl stop aipbx-coturn-restart.service >/dev/null 2>&1 || true
                    systemd-run --quiet --collect --unit=aipbx-coturn-restart /bin/bash -c \
                        'for i in $(seq 1 2880); do n=$(asterisk -rx "core show channels count" 2>/dev/null | awk "/active call/{print \$1}"); [ "$n" = 0 ] && exec systemctl restart coturn; sleep 15; done' \
                        && echo "coturn: restarts when no call is up"
                fi
                if [ -f /etc/systemd/system/aipbx-mdns.service ] && grep -q " ${old}\$" /etc/systemd/system/aipbx-mdns.service; then
                    sed -i "s/ ${old//./\\.}\$/ ${new}/; s/-> ${old//./\\.})/-> ${new})/" /etc/systemd/system/aipbx-mdns.service
                    systemctl daemon-reload; systemctl restart aipbx-mdns.service >/dev/null 2>&1 || true
                    echo "mdns: alias now on $new"
                fi
                if [ -r /etc/ssl/aipbx/mode ] && [ "$(cat /etc/ssl/aipbx/mode)" = selfsigned ] \
                   && openssl x509 -noout -ext subjectAltName -in /etc/ssl/aipbx/aipbx.crt 2>/dev/null | grep -q "IP Address:${old}\$\|IP Address:${old},"; then
                    rm -f /etc/ssl/aipbx/aipbx.crt /etc/ssl/aipbx/aipbx.key
                    /usr/local/sbin/aipbx-cert selfsigned >/dev/null 2>&1 && echo "certificate: self-signed certificate issued for $new" \
                        || echo "certificate: FAILED to issue a new self-signed certificate (run: aipbx-cert selfsigned)"
                fi
                exit 0
                ;;
            *) die "unknown net command: $sub" ;;
        esac
        ;;

    *)
        die "unknown command: ${cmd:-<empty>}"
        ;;
esac
