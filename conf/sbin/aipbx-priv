#!/bin/bash
# aipbx-priv — the ONLY command the AI PBX web portal may run as root.
#
# /etc/sudoers.d/aipbx grants www-data this script and nothing else. Before,
# asterisk/postconf/fail2ban-client/firewall-cmd were allowed without argument
# restrictions, so any code execution bug in the portal led straight to root
# (e.g. `sudo asterisk -C <fake.conf>`,
# `fail2ban-client set <jail> action ... actionban <komut>`,
# `postconf -e mailbox_command=...`). Here every subcommand maps to one fixed
# operation and every argument is validated against a strict pattern; no value
# ever reaches a shell.
#
# install.sh COPIES this file to /usr/local/sbin as root:root 0755 — it must
# never run from a location www-data can write to (e.g. under web/).

# shellcheck disable=SC2034  # the RE_* patterns are used by the handlers in aipbx-priv.d
set -uo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

die() { echo "aipbx-priv: $*" >&2; exit 64; }

RE_JAIL='^[A-Za-z0-9_-]{1,64}$'
RE_IP='^[0-9A-Fa-f:.]{2,45}(/[0-9]{1,3})?$'
RE_IPV4_CIDR='^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(/(3[0-2]|[12]?[0-9]))?$'
RE_INT='^[0-9]{1,9}$'
RE_PORT='^[0-9]{1,5}(-[0-9]{1,5})?$'
RE_PROTO='^(tcp|udp)$'
RE_HOST='^[A-Za-z0-9.:_-]{1,253}$'
RE_RICH_RULE='^rule [A-Za-z0-9 ="./:_-]{1,400}$'
RE_EMAIL='^[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9.-]{1,253}$'

match() { [[ "$1" =~ $2 ]] || die "invalid value: $1"; }

# Optional last argument: only "--permanent" is accepted.
permanent_flag() {
    case "${1:-}" in
        '') ;;
        --permanent) echo --permanent ;;
        *) die "unexpected argument: $1" ;;
    esac
}

# The handlers of the larger subcommands are in /usr/local/lib/aipbx-priv (conf/sbin/aipbx-priv.d in the source), installed
# by install.sh as root:root. Each is named by a literal of the case below, never by anything the caller passes, and one
# that root does not own, or that anybody else may write, is not read.
PRIV_LIB=/usr/local/lib/aipbx-priv
load() {
    local name="$1" f="$PRIV_LIB/$1.sh" du dm fu fm
    { [ ! -L "$PRIV_LIB" ] && [ ! -L "$f" ] && [ -f "$f" ]; } || die "missing handler: $name"
    read -r du dm fu fm < <(stat -c '%u %a' "$PRIV_LIB" "$f" | tr '\n' ' ')
    { [ "$du" = 0 ] && [ "$fu" = 0 ] && (( (8#$dm & 8#022) == 0 && (8#$fm & 8#022) == 0 )); } || die "handler not trusted: $name"
    # shellcheck source=/dev/null
    . "$f"
}

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
    plugin-schema)
        # plugin-schema apply|drop SLUG
        [ $# -eq 2 ] || die "usage: plugin-schema apply|drop SLUG"
        case "$1" in apply|drop) ;; *) die "invalid operation: $1" ;; esac
        match "$2" '^[a-z0-9_-]{2,64}$'
        WEB_DIR="$(readlink -f /var/www/html 2>/dev/null || echo /opt/aipbx/web)"
        [ -f "$WEB_DIR/bin/plugin_schema.php" ] || die "plugin_schema.php not found"
        if command -v systemd-run >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            exec systemd-run --pipe --wait --service-type=exec -q \
                /usr/bin/php "$WEB_DIR/bin/plugin_schema.php" "$1" "$2"
        else
            exec /usr/bin/php "$WEB_DIR/bin/plugin_schema.php" "$1" "$2"
        fi
        ;;

    asterisk-conf)
        # asterisk-conf write FILE < content
        [ $# -eq 2 ] && [ "$1" = write ] || die "usage: asterisk-conf write FILE < content"
        case "$2" in
            rtp.conf|udptl.conf|voicemail.conf|codecs.conf) ;;
            *) die "file not allowed: $2" ;;
        esac
        target="/etc/asterisk/$2"
        tmp="$(mktemp /etc/asterisk/.${2}.tmp.XXXXXX 2>/dev/null || mktemp /tmp/.${2}.tmp.XXXXXX)"
        cat > "$tmp" || { rm -f "$tmp"; die "cannot write content"; }
        chown asterisk:asterisk "$tmp"
        chmod 0664 "$tmp"
        if ! mv -f "$tmp" "$target" 2>/dev/null; then
            cp -f "$tmp" "$target" && rm -f "$tmp" || { rm -f "$tmp"; die "cannot install $target"; }
        fi
        chown asterisk:asterisk "$target"
        chmod 0664 "$target"
        exit 0
        ;;

    proxy-https)
        [ $# -eq 1 ] && [ "$1" = apply ] || die "usage: proxy-https apply < settings.json"
        exec /usr/bin/python3 -I /usr/local/sbin/aipbx-proxy-https apply
        ;;

    service)
        # service restart|reload UNIT
        [ $# -eq 2 ] || die "usage: service restart|reload UNIT"
        case "$1" in restart|reload) ;; *) die "invalid operation: $1" ;; esac
        # The same list as SystemServicesService (dashboard).
        case "$2" in
            asterisk|apache2|nginx|mariadb|postfix|coturn|firewalld|fail2ban|chrony|ssh) ;;
            aipbx-chat|aipbx-signaling|aipbx-webhook-worker|aipbx-call-events|aipbx-ai|aipbx-mdns|aipbx-dnsmasq|aipbx-syslog|aipbx-vsftpd) ;;
            aipbx-vpn@*) match "$2" '^aipbx-vpn@[A-Za-z0-9_-]{1,32}$' ;;
            *) die "service not allowed: $2" ;;
        esac
        exec systemctl "$1" "$2"
        ;;

    postfix)
        load postfix
        priv_postfix "$@"
        ;;

    fw)
        load fw
        priv_fw "$@"
        ;;

    f2b)
        load f2b
        priv_f2b "$@"
        ;;

    cert)
        load cert
        priv_cert "$@"
        ;;

    update)
        # System Update page: version check and starting an update. The update
        # runs in the background as a separate systemd unit (the portal's Apache
        # is restarted during it, so it cannot run inside a request); progress
        # is read from /var/lib/aipbx-system/update-status.json.
        sub="${1:-}"; [ $# -gt 0 ] && shift
        case "$sub" in
            check)
                [ $# -eq 0 ] || die "usage: update check"
                exec /usr/local/sbin/aipbx-update --check
                ;;
            start)
                # update start [--allow-calls|--wait-calls]
                [ $# -le 1 ] || die "usage: update start [--allow-calls|--wait-calls]"
                extra=""
                case "${1:-}" in '') ;; --allow-calls) extra="--allow-calls" ;; --wait-calls) extra="--wait-calls" ;; *) die "unexpected argument: $1" ;; esac
                if systemctl is-active --quiet aipbx-update.service; then
                    die "an update is already running"
                fi
                systemctl reset-failed aipbx-update.service >/dev/null 2>&1 || true
                exec systemd-run --quiet --collect --unit=aipbx-update \
                    --setenv=HOME=/root \
                    --description="AiPBX update" /usr/local/sbin/aipbx-update --yes $extra
                ;;
            end-calls|cancel)
                # While an update waits for calls: end them after all, or give up.
                [ $# -eq 0 ] || die "usage: update $sub"
                # Also for an update started at the terminal, which is not that unit.
                grep -q '"waiting_calls":[1-9]' /var/lib/aipbx-system/update-status.json 2>/dev/null || die "no update is waiting for calls"
                if [ "$sub" = end-calls ]; then touch /run/aipbx-update-end-calls; else touch /run/aipbx-update-cancel; fi
                ;;
            *) die "unknown update command: $sub" ;;
        esac
        ;;

    backup)
        load backup
        priv_backup "$@"
        ;;

    sounds)
        # Sounds page → Asterisk sound packs: sounds install|remove KIND LANG FORMAT.
        # Downloading can take minutes, so it runs in its own systemd unit;
        # progress is read from /var/lib/aipbx-system/sound-packs-status.json.
        [ $# -eq 4 ] || die "usage: sounds install|remove KIND LANG FORMAT"
        case "$1" in install|remove) ;; *) die "invalid operation: $1" ;; esac
        case "$2" in core|extra|moh) ;; *) die "invalid kind: $2" ;; esac
        match "$3" '^([a-z]{2}(_[A-Z]{2})?|opsound)$'
        case "$4" in wav|ulaw|alaw|gsm|g722|sln16) ;; *) die "invalid format: $4" ;; esac
        if systemctl is-active --quiet aipbx-sounds.service; then
            die "a sound pack operation is already running"
        fi
        systemctl reset-failed aipbx-sounds.service >/dev/null 2>&1 || true
        exec systemd-run --quiet --collect --unit=aipbx-sounds \
            --description="AiPBX sound pack: $1 $2-$3-$4" /usr/local/sbin/aipbx-sounds "$1" "$2" "$3" "$4"
        ;;

    timezone)
        # timezone ZONE — one time zone for the system, the portal and Asterisk. The
        # database and long-running services read it when they start, so they restart;
        # in a moment, because the portal asking for this restarts too.
        [ $# -eq 1 ] || die "usage: timezone ZONE"
        match "$1" '^[A-Za-z_+-]+(/[A-Za-z0-9_+-]+){0,2}$'
        [ -f "/usr/share/zoneinfo/$1" ] || die "unknown time zone: $1"
        timedatectl set-timezone "$1" || die "could not set the time zone"
        # In the unit, not here: Apache's sandbox keeps the environment file read-only.
        exec systemd-run --quiet --collect --on-active=3 --setenv=ZONE="$1" --description="AiPBX: time zone changed" /bin/sh -c \
            'if grep -q "^TIMEZONE=" /etc/ai-pbx.env; then sed -i "s|^TIMEZONE=.*|TIMEZONE=$ZONE|" /etc/ai-pbx.env; else echo "TIMEZONE=$ZONE" >> /etc/ai-pbx.env; fi
             for s in mariadb asterisk cron aipbx-webhook-worker aipbx-call-events aipbx-chat apache2; do systemctl try-restart "$s"; done'
        ;;

    tones)
        # tones show | tones set COUNTRY — ring and busy tones (indications.conf, asterisk:asterisk 0640).
        conf=/etc/asterisk/indications.conf
        [ -f "$conf" ] || die "$conf not found"
        case "${1:-}" in
            show)
                sed -n 's/^country=\([a-z]*\).*/\1/p' "$conf" | head -n 1
                ;;
            set)
                [ $# -eq 2 ] || die "usage: tones set COUNTRY"
                match "$2" '^[a-z]{2}$'
                # Asterisk's own file has no Turkey; AiPBX ships those tones.
                if [ "$2" = tr ] && ! grep -q '^\[tr\]' "$conf"; then
                    src="$(readlink -f /var/www/html)/../conf/asterisk/indications.conf"
                    grep -q '^\[tr\]' "$src" 2>/dev/null || die "tones for tr not found"
                    { echo; sed -n '/^\[tr\]/,$p' "$src"; } >> "$conf"
                fi
                grep -q "^\[$2\]" "$conf" || die "no tones for: $2"
                sed -i "s/^country=[a-z]*/country=$2/" "$conf"
                exec asterisk -rx 'module reload indications'
                ;;
            *) die "usage: tones show | tones set COUNTRY" ;;
        esac
        ;;

    sip443)
        load sip443
        priv_sip443 "$@"
        ;;

    asterisk-lang)
        # asterisk-lang LANG — [options] defaultlanguage in asterisk.conf (the
        # file is asterisk:asterisk 0640, the portal cannot write it). Takes
        # effect after a full Asterisk restart.
        [ $# -eq 1 ] || die "usage: asterisk-lang LANG"
        match "$1" '^[A-Za-z]{2,3}(_[A-Za-z]{2,4})?$'
        conf=/etc/asterisk/asterisk.conf
        [ -f "$conf" ] || die "$conf not found"
        # An active line wins; else uncomment the sample line; else add one.
        for re in '^defaultlanguage[[:space:]]*=.*' '^;[[:space:]]*defaultlanguage[[:space:]]*=.*'; do
            if grep -q "$re" "$conf"; then
                exec sed -i "0,/$re/s//defaultlanguage = $1/" "$conf"
            fi
        done
        if grep -q '^\[options\]' "$conf"; then
            exec sed -i "/^\[options\]/a defaultlanguage = $1" "$conf"
        else
            printf "\n[options]\ndefaultlanguage = %s\n" "$1" >> "$conf"
            exit 0
        fi
        ;;

    netsvc)
        load netsvc
        priv_netsvc "$@"
        ;;

    ai)
        # AI → Local models (roadmap 5): the runtime of the local AI service
        # (Python venv with torch, about 1 GB) and its unit. Installing
        # takes minutes, so it runs detached in its own unit; progress is read
        # with `ai runtime-status` (/var/lib/aipbx-ai/runtime.json). Models
        # themselves are managed over the service's own API (127.0.0.1:8790).
        sub="${1:-}"; [ $# -gt 0 ] && shift
        [ $# -eq 0 ] || die "usage: ai runtime-install|runtime-remove|runtime-status|restart"
        case "$sub" in
            runtime-install|runtime-remove)
                if systemctl is-active --quiet aipbx-ai-setup.service; then
                    die "an AI runtime operation is already running"
                fi
                systemctl reset-failed aipbx-ai-setup.service >/dev/null 2>&1 || true
                if [ "$sub" = runtime-install ]; then
                    exec systemd-run --quiet --collect --unit=aipbx-ai-setup \
                        --description="AiPBX AI runtime: install" /usr/local/sbin/aipbx-ai-setup install
                fi
                # Seconds only, but outside Apache's sandbox like everything
                # that deletes under /opt; --wait returns its result.
                exec systemd-run --quiet --wait --pipe --collect --unit=aipbx-ai-setup \
                    --description="AiPBX AI runtime: remove" /usr/local/sbin/aipbx-ai-setup remove
                ;;
            runtime-status)
                exec /usr/local/sbin/aipbx-ai-setup status
                ;;
            restart)
                [ -x /opt/aipbx-ai/venv/bin/python ] || die "the AI runtime is not installed"
                exec systemctl restart aipbx-ai.service
                ;;
            *) die "unknown ai command: $sub" ;;
        esac
        ;;

    net)
        load net
        priv_net "$@"
        ;;

    netcfg)
        # netcfg status|apply|confirm|revert — this server's own address (Network settings).
        # aipbx-netcfg checks every value; its do-* steps are for its own units, not offered here.
        case "${1:-}" in
            status|apply|confirm|revert) ;;
            *) die "unknown netcfg command: ${1:-<empty>}" ;;
        esac
        exec /usr/local/sbin/aipbx-netcfg "$@"
        ;;

    diag)
        # diag start [minutes=N]|stop|status|delete name=FILE — the problem recording of
        # System -> Health checks. aipbx-diag checks every value itself.
        case "${1:-}" in
            start|stop|status|delete) ;;
            *) die "unknown diag command: ${1:-<empty>}" ;;
        esac
        exec /usr/local/sbin/aipbx-diag "$@"
        ;;

    vpn)
        # vpn SUBCOMMAND ... — Network -> VPN Server and VPN Client. aipbx-vpn checks every
        # value (profiles arrive on stdin) and is what holds the keys; "run" is for its
        # own systemd unit and is not offered here.
        case "${1:-}" in
            status|server-set|peer-add|peer-del|peer-profile|peer-yealink|tunnel-add|tunnel-set|tunnel-del|log) ;;
            *) die "unknown vpn command: ${1:-<empty>}" ;;
        esac
        exec /usr/local/sbin/aipbx-vpn "$@"
        ;;

    *)
        die "unknown command: ${cmd:-<empty>}"
        ;;
esac
