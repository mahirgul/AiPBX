# AiPBX connector agent — configuration
#
# Installed to /etc/aipbx/agent.conf (0640 root:root). The node key is shown
# ONCE when the setup command is created in the cloud portal, and only its
# sha256 hash is stored server-side — so if this file is lost, the node is
# re-issued, not recovered.
#
# Get the values from: app.echoguard.ca → Nodes → "Add node" → the setup
# command prints the endpoint, node_id and key.

[aipbx]
endpoint = https://app.echoguard.ca
node_id = 123
key = <one-time node key>

# Optional overrides — normally leave these out.
#
# ops_php: the sealed op executor this agent is allowed to run.
# ops_php = /usr/local/bin/aipbx_ops.php
#
# platform_version: reported to the cloud as the node's AiPBX version. Read
# from VERSION automatically; set it only if that file is somewhere unusual.
# platform_version = 1.33.0
