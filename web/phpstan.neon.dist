# PHPStan static analysis: CI (.github/workflows/web-ci.yml) runs it on every push.
# Yerelde: vendor/bin/phpstan analyse
#
# phpstan-baseline.neon: the findings that existed when this configuration was
# added (2026-09-27). CI fails only on NEW errors; shrink the baseline over time
# (after fixing a finding: `vendor/bin/phpstan analyse --generate-baseline`).
includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - api
        - bin
        - modules
        - config.php
        - auth.php
        - index.php
    scanFiles:
        - config.php
    tmpDir: .phpstan-cache
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # The define() constants of config.php are read from /etc/ai-pbx.env at
        # run time; PHPStan cannot see them.
        - identifier: constant.notFound
