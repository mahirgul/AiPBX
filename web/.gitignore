*.log
*.swp
*.bak
.DS_Store

# Composer dependencies: composer.json/composer.lock are tracked, vendor/ is
# rebuilt by 'composer install' and never committed.
/vendor/

# Let's Encrypt HTTP-01 challenge tokens: certbot writes temporary files here
# while renewing; keep them out of git (see the ACME exception in
# le-redirect-*.conf, 2026-08-31).
/.well-known/

# Test database credentials: never committed
/tests/.env.test
/.phpunit.cache
*.apk
*.aab
.phpstan-cache/
