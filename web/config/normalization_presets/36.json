{
    "country": "36",
    "name": "Hungary",
    "outbound": [
        {
            "client_type": "desktop",
            "rule_name": "Desk phones: E.164 Hungary (+36 -> 06)",
            "match_pattern": "_+36.",
            "strip_front": 3,
            "prepend": "06",
            "strip_back": 0,
            "append": "",
            "sort_order": 3,
            "is_active": 1,
            "description": "+36 numbers become national numbers with the prefix 06."
        },
        {
            "client_type": "desktop",
            "rule_name": "Desk phones: E.164 international (+ -> 00)",
