{
    "slug": "signaling-capture",
    "name": "SIP Signaling Capture (HEPv3 / Homer & Webhook Telemetry)",
    "name_i18n": {
        "tr": "SIP Sinyal Yakalama (HEPv3 / Homer ve Telemetri)",
        "en": "SIP Signaling Capture (HEPv3 / Homer & Webhook Telemetry)"
    },
    "version": "1.0.0",
    "author": "Gregory Merriweather (shido6)",
    "category": "telemetry",
    "icon": "fas fa-satellite-dish",
    "icon_style": "color: #0ea5e9;",
    "description": "Stream Asterisk PJSIP signaling and RTCP telemetry via HEPv3 to Homer / Sipcapture servers or external HTTP telemetry collectors.",
    "description_i18n": {
        "tr": "Asterisk PJSIP sinyal ve RTCP kalite verilerini HEPv3 protokolü ile Homer / Sipcapture sunucularına veya dış telemetri servislerine aktarır.",
        "en": "Stream Asterisk PJSIP signaling and RTCP telemetry via HEPv3 to Homer / Sipcapture servers or external HTTP telemetry collectors."
    },
    "scopes": [
        "calls:read",
        "system:read"
    ],
    "hooks": {
        "sync_domain": "general_dialplan",
        "events": [
            "call.started",
            "call.answered",
            "call.ended",
            "call.missed"
        ],
        "admin_page": {
            "group": "integrations"
        }
    },
    "settings_schema": [
        {
            "key": "hep_enabled",
            "type": "boolean",
            "default": "1",
            "label": "Enable Asterisk HEPv3 Packet Capture (res_hep_pjsip & res_hep_rtcp)",
            "label_i18n": {
                "tr": "Asterisk HEPv3 Paket Yakalamayı Etkinleştir (res_hep_pjsip & res_hep_rtcp)"
            }
        },
        {
            "key": "capture_address",
            "type": "text",
            "default": "127.0.0.1:9060",
            "placeholder": "10.0.0.50:9060",
            "label": "HEP Collector Address (IP:Port)",
            "label_i18n": {
                "tr": "HEP Sunucu Adresi (IP:Port)"
            },
            "help": "Homer / Heplify / Kamailio HEPv3 UDP collector address and port."
        },
        {
            "key": "capture_id",
            "type": "number",
            "default": "2001",
            "label": "HEP Capture Node ID",
            "label_i18n": {
                "tr": "HEP Düğüm Kimliği (Capture ID)"
            }
        },
        {
            "key": "capture_password",
            "type": "password",
            "secret": true,
            "default": "",
            "label": "HEP Capture Password (Optional)",
            "label_i18n": {
                "tr": "HEP Yakalama Parolası (İsteğe Bağlı)"
            }
        },
        {
            "key": "uuid_type",
            "type": "select",
            "default": "call-id",
            "options": {
                "call-id": "SIP Call-ID (call-id)",
                "channel": "Asterisk Channel Name (channel)"
            },
            "label": "Correlation UUID Type",
            "label_i18n": {
                "tr": "Eşleştirme Kimliği Türü (UUID Type)"
            }
        },
        {
            "key": "collector_webhook_url",
            "type": "text",
            "default": "",
            "placeholder": "https://telemetry.example.com/v1/sip-events",
            "label": "External HTTP Telemetry Collector URL (Optional)",
            "label_i18n": {
                "tr": "Harici HTTP Telemetri Webhook Adresi (İsteğe Bağlı)"
            }
        },
        {
            "key": "collector_api_key",
            "type": "password",
            "secret": true,
            "default": "",
            "label": "Collector Bearer API Key (Optional)",
            "label_i18n": {
                "tr": "Harici Sunucu API Anahtarı (İsteğe Bağlı)"
            }
        }
    ],
    "type": "community",
    "author_url": "https://github.com/shido6"
}