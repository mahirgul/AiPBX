# Template for the compose deployment's *settings*. Do not copy this file by
# hand: run
#
#   ./docker/gen-secrets.sh
#
# which writes this equivalent .env together with the credentials, in
# docker/secrets/db.env and docker/secrets/init.env (docker/README.md).
#
# There are deliberately no credentials in this file. A password here would be
# interpolated into compose.yaml and so handed to every tier, including the four
# that read theirs from /etc/ai-pbx.env and would never look at it. The values
# live in the two per-service files instead, which are generated, 0600, and
# git-ignored.

# --- Database (the MariaDB container creates these users on first start) ---
AIPBX_DB_NAME=asterisk
AIPBX_DB_USER=aipbx
AIPBX_DB_MIGRATOR_USER=aipbx_migrator
AIPBX_DB_ODBC_USER=asterisk_odbc

# --- Asterisk AMI -----------------------------------------------------------
AIPBX_AMI_USER=aipbx
AIPBX_AMI_PORT=5038

# --- Deployment identity ----------------------------------------------------
AIPBX_DOMAIN=aipbx.local
AIPBX_SITE_NAME=AI PBX Portal
AIPBX_TIMEZONE=Europe/Istanbul

# --- Ports (host networking: the containers bind these on this machine) -----
AIPBX_HTTP_PORT=80
AIPBX_DB_PORT=3306
AIPBX_RTP_RANGE=10000-10199

# Asterisk 22 is what Ubuntu 26.04 ships and what the portal targets.
AIPBX_ASTERISK_VERSION=22
