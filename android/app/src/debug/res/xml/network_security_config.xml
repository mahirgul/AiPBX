<?xml version="1.0" encoding="utf-8"?>
<!--
    For the DEBUG build ONLY; it is not in the release package. The user CA
    store is trusted too: an admin who wants to test against a self-signed
    server installs their own root certificate on the device.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
