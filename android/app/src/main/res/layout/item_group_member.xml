<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp">

        <TextView
            android:id="@+id/tvMemberAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/circle_avatar"
            android:gravity="center"
            android:text="U"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/vMemberStatusDot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/circle_status"
            android:backgroundTint="#9CA3AF" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMemberName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Kullanıcı Adı"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMemberExtension"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Dahili: 101"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMemberRoleBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:background="@drawable/chip_tab_btn_bg"
        android:backgroundTint="#DBEAFE"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="Yönetici"
        android:textColor="#1D4ED8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnMemberAction"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="İşlem Seçenekleri"
        android:src="@drawable/ic_call_transfer"
        app:tint="@color/text_secondary"
        android:visibility="gone" />

</LinearLayout>
