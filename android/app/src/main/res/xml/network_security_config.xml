<?xml version="1.0" encoding="utf-8"?>
<!--
    Production network policy (2026-09-05).

    The TLS bypasses in the code were removed; when a self-signed or company
    certificate is needed, the solution belongs here, not in the code. In
    production ONLY the system CA store is trusted and cleartext (http) traffic
    is forbidden.

    The debug build OVERRIDES this with its version under app/src/debug/res/xml
    and also trusts the user CA store. That file is NOT in the release package.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
