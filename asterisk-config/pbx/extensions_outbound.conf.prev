; Native Outbound Dialplan Context (Auto-generated by AI PBX)

; ---- Giden Rota Grubu 1 ----
[from-internal-outbound-1]

; Outbound Route: Acil Cagri (112 Acil) (Pattern: 112 -> Trunk: neco)
exten => 112,1,NoOp(Outbound Call via Route Acil Cagri (112 Acil) -> Trunk neco)
 same => n,Set(CDR(direction)=outbound)
 same => n,Set(CALLERID(num)=${IF($["${CID_EXTERNAL}" != ""]?${CID_EXTERNAL}:${CALLERID(num)})})
 same => n,Set(CALLERID(name)=)
 same => n,Set(REC_FILE=/var/spool/asterisk/monitor/outbound_${STRFTIME(${EPOCH},,%Y%m%d_%H%M%S)}_${CALLERID(num)}_to_${EXTEN}.wav)
 same => n,MixMonitor(${REC_FILE})
 same => n,Set(CDR(userfield)=${REC_FILE})
 same => n,Set(CHANNEL(accountcode)=${CALLERID(num)})
 same => n,Set(JITTERBUFFER(adaptive)=default)
 same => n,Dial(PJSIP/${EXTEN}@neco,60,Tb(sub-callee-jb^s^1))
 same => n,Goto(sub-outbound-status,${IF($["${DIALSTATUS}" != ""]?${DIALSTATUS}:NOANSWER)},1)

; Outbound Route: Sehir Ici / Sehirler Arasi (0NXX...) (Pattern: _0X. -> Trunk: neco)
exten => _0X.,1,NoOp(Outbound Call via Route Sehir Ici / Sehirler Arasi (0NXX...) -> Trunk neco)
 same => n,Set(CDR(direction)=outbound)
 same => n,Set(CALLERID(num)=${IF($["${CID_EXTERNAL}" != ""]?${CID_EXTERNAL}:${CALLERID(num)})})
 same => n,Set(CALLERID(name)=)
 same => n,Set(REC_FILE=/var/spool/asterisk/monitor/outbound_${STRFTIME(${EPOCH},,%Y%m%d_%H%M%S)}_${CALLERID(num)}_to_0${EXTEN}.wav)
 same => n,MixMonitor(${REC_FILE})
 same => n,Set(CDR(userfield)=${REC_FILE})
 same => n,Set(CHANNEL(accountcode)=${CALLERID(num)})
 same => n,Set(JITTERBUFFER(adaptive)=default)
 same => n,Dial(PJSIP/0${EXTEN}@neco,60,Tb(sub-callee-jb^s^1))
 same => n,Goto(sub-outbound-status,${IF($["${DIALSTATUS}" != ""]?${DIALSTATUS}:NOANSWER)},1)

; Outbound Route: dahili (Pattern: _[4-9]XXX -> Trunk: neco)
exten => _[4-9]XXX,1,NoOp(Outbound Call via Route dahili -> Trunk neco)
 same => n,Set(CDR(direction)=outbound)
 same => n,Set(CALLERID(num)=${IF($["${CID_INTERNAL}" != ""]?${CID_INTERNAL}:${CALLERID(num)})})
 same => n,Set(CALLERID(name)=)
 same => n,Set(REC_FILE=/var/spool/asterisk/monitor/outbound_${STRFTIME(${EPOCH},,%Y%m%d_%H%M%S)}_${CALLERID(num)}_to_${EXTEN}.wav)
 same => n,MixMonitor(${REC_FILE})
 same => n,Set(CDR(userfield)=${REC_FILE})
 same => n,Set(CHANNEL(accountcode)=${CALLERID(num)})
 same => n,Set(JITTERBUFFER(adaptive)=default)
 same => n,Dial(PJSIP/${EXTEN}@neco,60,Tb(sub-callee-jb^s^1))
 same => n,Goto(sub-outbound-status,${IF($["${DIALSTATUS}" != ""]?${DIALSTATUS}:NOANSWER)},1)

; ---- Geriye uyumluluk: grup 1'in eski adi ----
[from-internal-outbound]
include => from-internal-outbound-1

; ---- Giden Cagri Durum Yonetimi (D-1 / D-2) ----
[sub-outbound-status]
exten => s,1,NoOp(Outbound Status: s - Cause: ${HANGUPCAUSE})
 same => n,Hangup(${IF($["${HANGUPCAUSE}" != "" & "${HANGUPCAUSE}" != "0"]?${HANGUPCAUSE}:16)})

exten => ANSWER,1,NoOp(Outbound Status: ANSWER - Normal Hangup)
 same => n,Hangup(16)

exten => BUSY,1,NoOp(Outbound Status: BUSY - Cause: ${HANGUPCAUSE})
 same => n,Hangup(17)

exten => CONGESTION,1,NoOp(Outbound Status: CONGESTION - Cause: ${HANGUPCAUSE})
 same => n,Hangup(34)

exten => CHANUNAVAIL,1,NoOp(Outbound Status: CHANUNAVAIL - Cause: ${HANGUPCAUSE})
 same => n,Hangup(${IF($["${HANGUPCAUSE}" != "" & "${HANGUPCAUSE}" != "0"]?${HANGUPCAUSE}:1)})

exten => NOANSWER,1,NoOp(Outbound Status: NOANSWER - Cause: ${HANGUPCAUSE})
 same => n,Hangup(19)

exten => CANCEL,1,NoOp(Outbound Status: CANCEL)
 same => n,Hangup(16)

exten => DONTCALL,1,Hangup(21)

exten => TORTURE,1,Hangup(21)

exten => INVALIDARGS,1,Hangup(38)

exten => i,1,NoOp(Outbound Status: Unknown status - Cause: ${HANGUPCAUSE})
 same => n,Hangup(${IF($["${HANGUPCAUSE}" != "" & "${HANGUPCAUSE}" != "0"]?${HANGUPCAUSE}:16)})

exten => e,1,Hangup(16)

exten => h,1,NoOp(Outbound Channel Hangup Complete)

