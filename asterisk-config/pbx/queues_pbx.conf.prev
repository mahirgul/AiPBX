; ==========================================================
; Master Call Center Queues Configuration (Auto-generated by AI PBX via queues_details DB)
; ==========================================================

[general]
persistentmembers = yes
autofill = yes
monitor-type = MixMonitor
queue_log = yes

; Call Center Queue ID 1: CM (queue_cc)
[queue_cc]
musicclass=default
announce-frequency=30
announce-holdtime=yes
announce-position=yes
autofill=yes
joinempty=yes
leavewhenempty=no
maxlen=0
monitor-format=wav
periodic-announce=queue-youarenext,queue-thankyou
periodic-announce-frequency=45
retry=5
ringinuse=no
setinterfacevar=yes
setqueueentryvar=yes
setqueuevar=yes
strategy=rrmemory
timeout=15
wrapuptime=10

